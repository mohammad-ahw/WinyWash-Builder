<!-- ============================================================================== -->
<!-- CleanC UI Section 12: Windows 11 Privacy & Debloater Tool Full Page           -->
<!-- ============================================================================== -->
<StackPanel x:Name="ToolPrivacyPanel" Spacing="16" Visibility="Visible" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <!-- Top Bar -->
    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Button Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="حریم خصوصی و حذف تلمتری ویندوز ۱۱ (Privacy &amp; Debloater)" FontSize="16" FontWeight="Bold" LineHeight="24" />
                <TextBlock Text="قطع ارسال گزارش‌ها، پایش‌های مخفیانه و بهینه‌سازی سرعت جستجو با اعمال خودکار و بلادرنگ" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
            </StackPanel>
        </StackPanel>

        <!-- Auto-Save Status Badge -->
        <Border Grid.Column="1" Background="#1810B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE8FB;" FontSize="13" Foreground="#10B981" />
                <TextBlock Text="اعمال و ذخیره خودکار بلادرنگ" FontSize="11.5" FontWeight="SemiBold" Foreground="#10B981" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Informative Banner -->
    <Border CornerRadius="12" Padding="18,14" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*">
            <Border Width="40" Height="40" CornerRadius="10" Background="#1A10B981" Margin="0,0,14,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8F8;" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="محافظت از اطلاعات شخصی و افزایش سرعت سیستم" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="تمامی گزینه‌های زیر با سوییچ کردن به صورت بلادرنگ و بدون نیاز به فشردن دکمه در رجیستری و سرویس‌های ویندوز اعمال می‌شوند." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>

    <!-- Dynamic Privacy Cards List: Host for CreateToggleCard live switches -->
    <StackPanel x:Name="PrivacyCardsContainer" Spacing="10" />

    <!-- Bulk Actions Footer -->
    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
        <TextBlock Text="برای حداکثر امنیت و راندمان، فعال بودن تمام گزینه‌های محافظتی بالا پیشنهاد می‌شود." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="پیش‌فرض ویندوز" Height="34" Padding="14,0" CornerRadius="6" FontSize="11.5" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
            <Button Style="{ThemeResource AccentButtonStyle}" Height="34" Padding="16,0" CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE73E;" FontSize="13" />
                    <TextBlock Text="فعال‌سازی همه محافظت‌ها" FontSize="11.5" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</StackPanel>
