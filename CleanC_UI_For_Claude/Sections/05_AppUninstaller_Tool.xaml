<!-- ============================================================================== -->
<!-- CleanC UI Section 05: App Uninstaller Tool Full Page                          -->
<!-- ============================================================================== -->
<StackPanel x:Name="ToolAppUninstallerPanel" Spacing="16" Visibility="Visible" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <!-- Top Bar -->
    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Button Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="مدیریت و حذف نرم‌افزارهای نصب‌شده" FontSize="16" FontWeight="Bold" LineHeight="24" />
                <TextBlock x:Name="UninstallerSummaryText" Text="تعداد کل: 42 نرم‌افزار  •  حجم کل: 18.4 GB" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
            </StackPanel>
        </StackPanel>

        <!-- Search & Sort Controls -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <AutoSuggestBox x:Name="UninstallerSearchBox" PlaceholderText="جستجوی نرم‌افزار..." QueryIcon="Find" Width="200" Height="34" />
            <ComboBox x:Name="UninstallerSortBox" Height="34" CornerRadius="6">
                <ComboBoxItem Content="جدیدترین نصب" IsSelected="True" />
                <ComboBoxItem Content="بیشترین حجم" />
                <ComboBoxItem Content="نام (الفبا)" />
            </ComboBox>
        </StackPanel>
    </Grid>

    <!-- Batch Action Bar (Appears when items are checked) -->
    <Border x:Name="UninstallerBatchBar" Visibility="Visible" CornerRadius="10" Padding="14,10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <CheckBox x:Name="UninstallerSelectAllCheck" Content="انتخاب همه" FontSize="12" VerticalAlignment="Center" />
            <TextBlock x:Name="UninstallerSelectedCountText" Grid.Column="1" Text="۲ برنامه انتخاب شده" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <Button x:Name="UninstallerBatchDeleteBtn" Grid.Column="2" Height="34" Padding="16,0" CornerRadius="6" Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    <TextBlock x:Name="UninstallerBatchDeleteBtnText" Text="حذف برنامه‌های انتخاب‌شده" FontSize="11.5" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>

    <ProgressRing x:Name="UninstallerLoadingSpinner" IsActive="False" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,32,0,0" Visibility="Collapsed" />
    
    <!-- Dynamic List Container: Host for CreateAppUninstallerCard rows -->
    <StackPanel x:Name="UninstallerAppsStack" Spacing="8" Visibility="Visible" />
</StackPanel>
