<!-- ============================================================================== -->
<!-- CleanC UI Section 08: Startup Manager Tool Full Page                          -->
<!-- ============================================================================== -->
<StackPanel x:Name="ToolStartupManagerPanel" Spacing="16" Visibility="Visible" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <!-- Top Bar -->
    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Button Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="مدیریت برنامه‌های شروع خودکار (Startup)" FontSize="16" FontWeight="Bold" LineHeight="24" />
                <TextBlock x:Name="StartupManagerSummaryText" Text="تعداد کل: 14 برنامه  •  8 برنامه فعال  •  6 برنامه غیرفعال" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
            </StackPanel>
        </StackPanel>

        <Button Grid.Column="1" Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                <TextBlock Text="بروزرسانی لیست" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </Button>
    </Grid>

    <!-- Startup Items Container: Host for CreateStartupCard items -->
    <StackPanel x:Name="StartupCardsContainer" Spacing="10" />
</StackPanel>
