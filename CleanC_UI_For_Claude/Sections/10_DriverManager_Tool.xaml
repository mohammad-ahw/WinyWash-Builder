<!-- ============================================================================== -->
<!-- CleanC UI Section 10: Driver Manager Tool Full Page                           -->
<!-- ============================================================================== -->
<StackPanel x:Name="ToolDriversPanel" Spacing="16" Visibility="Visible" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <!-- Top Bar -->
    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Button Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="مدیریت و پاکسازی درایورهای ویندوز (Driver Manager)" FontSize="16" FontWeight="Bold" LineHeight="24" />
                <TextBlock Text="شناسایی کدهای خطای سخت‌افزاری، پاکسازی ایمن نسخه‌های تکراری DriverStore و آپدیت درایورها" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="#0284C7" />
                    <TextBlock Text="بررسی آپدیت درایورها" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
            <Button Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                    <TextBlock Text="بروزرسانی لیست" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>

    <!-- Summary Stats Banner (3 Columns) -->
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <Border CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#3B82F6" BorderThickness="0,0,0,3">
            <StackPanel Spacing="3" HorizontalAlignment="Center">
                <TextBlock Text="کل بسته‌های درایور" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DriversTotalCountText" Text="68 بسته" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#EF4444" BorderThickness="0,0,0,3">
            <StackPanel Spacing="3" HorizontalAlignment="Center">
                <TextBlock Text="خطاهای سخت‌افزاری" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DriversErrorCountText" Text="۰ خطا" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#F59E0B" BorderThickness="0,0,0,3">
            <StackPanel Spacing="3" HorizontalAlignment="Center">
                <TextBlock Text="نسخه‌های تکراری قدیمی" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DriversDuplicateCountText" Text="۳ بسته" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Duplicate Cleanup Action Banner -->
    <Border x:Name="DriversDuplicateBanner" Visibility="Visible" CornerRadius="10" Padding="18,14" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="#F59E0B" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="DriversDuplicateBannerTitle" Text="پاکسازی بسته‌های تکراری و اشغال‌کننده فضای سیستم" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="این درایورها نسخه‌های قدیمی‌تر هستند که با نصب نسخه جدید جایگزین شده‌اند و با ایجاد Restore Point به صورت ایمن حذف می‌شوند." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="پاکسازی درایورهای قدیمی DriverStore" Height="34" CornerRadius="8" FontWeight="SemiBold" FontSize="11.5" Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Border>

    <!-- Drivers Batch Selection & Deletion Bar -->
    <Border x:Name="DriversBatchBar" Visibility="Visible" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <CheckBox x:Name="DriversSelectAll" Content="انتخاب همه درایورها" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="DriversSelectedCountText" Grid.Column="1" Text="۲ درایور انتخاب شده" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" />
            <Button Grid.Column="2" Height="34" CornerRadius="6" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Padding="16,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                    <TextBlock x:Name="DriversBatchDeleteBtnText" Text="حذف درایورهای انتخاب‌شده" FontSize="11.5" />
                </StackPanel>
            </Button>
        </Grid>
    </Border>

    <!-- Search / Filter -->
    <AutoSuggestBox x:Name="DriversSearchBox" PlaceholderText="جستجو در بین درایورها..." QueryIcon="Find" Height="36" />

    <ProgressRing x:Name="DriversLoadingSpinner" IsActive="False" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,24,0,0" Visibility="Collapsed" />
    
    <!-- Driver Items Container: Host for CreateDriverCard items -->
    <StackPanel x:Name="DriversCardsContainer" Spacing="8" Visibility="Visible" />
</StackPanel>
