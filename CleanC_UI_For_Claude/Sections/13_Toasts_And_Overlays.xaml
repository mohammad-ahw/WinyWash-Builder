<!-- ============================================================================== -->
<!-- CleanC UI Section 13: Floating Toast Notification & Dialogs Overlay           -->
<!-- ============================================================================== -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <!-- Global Floating Toast Notification (Appears seamlessly over ANY active view) -->
    <Border x:Name="FloatingToastCard"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Canvas.ZIndex="999"
            Margin="0,16,0,0"
            Padding="16,10,14,10"
            CornerRadius="12"
            Background="{ThemeResource AppToastBackgroundBrush}"
            BorderBrush="{ThemeResource AppToastBorderBrush}"
            BorderThickness="1"
            Translation="0,0,32"
            MaxWidth="560"
            Visibility="Visible"
            Opacity="1"
            FlowDirection="RightToLeft">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Border x:Name="ToastIconBox" Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1A10B981" VerticalAlignment="Center" Margin="0,0,12,0">
                <FontIcon x:Name="ToastIcon" Glyph="&#xE73E;" FontSize="13" Foreground="#10B981" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="ToastTitleText" Text="عملیات موفق" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="ToastMessageText" Text="تنظیمات با موفقیت در سیستم‌عامل اعمال و ذخیره شدند." FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="ToastCloseBtn" Grid.Column="2" Width="26" Height="26" Padding="0" Margin="12,0,0,0" Background="Transparent" BorderThickness="0" CornerRadius="13" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>
    </Border>
</Grid>
