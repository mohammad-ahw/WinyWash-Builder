<!-- ============================================================================== -->
<!-- CleanC UI Section 01: Window Header, Custom TitleBar & Navigation Switcher    -->
<!-- ============================================================================== -->
<Grid RowDefinitions="Auto,Auto" Background="{ThemeResource WindowCanvasBrush}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">

    <!-- 1. Custom Seamless WinUI 3 Title Bar -->
    <Border Grid.Row="0"
            Height="54"
            Background="{ThemeResource AppHeaderBackgroundBrush}"
            BorderBrush="{ThemeResource AppHeaderBorderBrush}"
            BorderThickness="0,0,0,1">
        <Grid x:Name="AppTitleBar" FlowDirection="LeftToRight" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand / Logo (Left) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.25" Margin="-1" />
                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                        <Image Source="Assets/Logo.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="AppTitleText" Text="CleanC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}" Margin="2,0,0,0" VerticalAlignment="Center" />
                    <Border x:Name="AdminBadge" 
                            Visibility="Collapsed" 
                            Background="{ThemeResource AdminBadgeBackgroundBrush}" 
                            BorderBrush="{ThemeResource AdminBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10" 
                            Padding="7,2" 
                            Margin="6,0,0,0" 
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7EF;" FontSize="10" Foreground="{ThemeResource AdminBadgeForegroundBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Running as admin" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AdminBadgeForegroundBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Drag Region (Center) -->
            <Border x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent" />

            <!-- Quick Action Tools on Titlebar (Right, before caption buttons) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,12,0">
                <Button x:Name="UndoCenterBtn" ToolTipService.ToolTip="مرکز بازیابی و بازگشت تغییرات" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Width="32" Height="32" Padding="0" CornerRadius="16">
                    <FontIcon Glyph="&#xE777;" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <Button x:Name="RefreshStatsBtn" ToolTipService.ToolTip="بروزرسانی وضعیت سیستم" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Width="32" Height="32" Padding="0" CornerRadius="16">
                    <FontIcon x:Name="RefreshStatsIcon" Glyph="&#xE72C;" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
                <Button x:Name="NotificationHistoryBtn" ToolTipService.ToolTip="تاریخچه اعلان‌ها" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Width="32" Height="32" Padding="0" CornerRadius="16">
                    <Grid>
                        <FontIcon Glyph="&#xEA8F;" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Ellipse x:Name="NotificationBadgeDot" Width="7" Height="7" Fill="#3B82F6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="ThemeToggleBtn" ToolTipService.ToolTip="تغییر تم (تاریک / روشن)" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Width="32" Height="32" Padding="0" CornerRadius="16">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
            </StackPanel>

            <!-- Dedicated Reserved Space for Windows Caption Buttons (- □ ✕) -->
            <Border x:Name="CaptionButtonsSpacer" Grid.Column="3" Width="144" Background="Transparent" />
        </Grid>
    </Border>

    <!-- 2. Modern Fluent 2 Floating Segmented Pill Switcher (Tab Navigation) -->
    <Border Grid.Row="1"
            HorizontalAlignment="Center"
            Background="{ThemeResource AppHeaderPillBrush}"
            BorderBrush="{ThemeResource AppCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="19"
            Padding="3"
            Margin="0,12,0,16"
            FlowDirection="RightToLeft">
        <StackPanel Orientation="Horizontal" Spacing="3">
            <!-- Dashboard Tab Pill Button -->
            <Button x:Name="NavDashboardBtn"
                    Height="34"
                    Padding="18,0"
                    CornerRadius="16"
                    Background="{ThemeResource AppCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="NavDashboardIcon" Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="NavDashboardText" Text="داشبورد بهینه‌سازی" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Button>

            <!-- System Tools Tab Pill Button -->
            <Button x:Name="NavToolsBtn"
                    Height="34"
                    Padding="18,0"
                    CornerRadius="16"
                    Background="Transparent"
                    BorderThickness="0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="NavToolsIcon" Glyph="&#xE713;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="NavToolsText" Text="ابزارهای سیستمی ویندوز" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Grid>
