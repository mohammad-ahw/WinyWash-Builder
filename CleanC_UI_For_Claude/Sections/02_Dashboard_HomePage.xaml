<!-- ============================================================================== -->
<!-- CleanC UI Section 02: Unified 1-Click Dashboard (Home Page)                   -->
<!-- ============================================================================== -->
<ScrollViewer x:Name="DashboardView" 
              VerticalScrollBarVisibility="Auto" 
              HorizontalScrollBarVisibility="Disabled"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Grid HorizontalAlignment="Stretch">
        <StackPanel x:Name="DashboardContentPanel" Spacing="16" HorizontalAlignment="Stretch" MaxWidth="960">
        
        <!-- 1. Hero 1-Click Smart Boost Card -->
        <Border x:Name="HeroCard" CornerRadius="14" Padding="26,20" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" Translation="0,0,32">
            <Grid x:Name="HeroContentGrid" ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                <StackPanel x:Name="HeroTextStack" Grid.Column="0" VerticalAlignment="Center" Spacing="6" MinWidth="220">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeroHealthCategoryText" Text="وضعیت سلامت و کارایی سیستم" FontSize="11.5" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="HeroHealthTitle" Text="سیستم آماده بهینه‌سازی است" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="HeroHealthSubtitle" Text="تنها با ۱ کلیک فایل‌های موقت پاک، حافظه رم آزاد و پردازه‌های اضافی بسته می‌شوند." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="HeroActionStack" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="16" Margin="16,0,0,0">
                    <!-- Visual RAM Ring -->
                    <Grid Width="66" Height="66">
                        <ProgressRing x:Name="HeroRamRing" Width="66" Height="66" Minimum="0" Maximum="100" Value="60" IsIndeterminate="False" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="HeroRamPercentText" Text="60%" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="HeroRamPercentSubtitle" Text="رم" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Professional Boost Button -->
                    <Button x:Name="QuickBoostBtn" 
                            Style="{ThemeResource AccentButtonStyle}"
                            CornerRadius="9" 
                            Height="48"
                            Padding="22,0">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon x:Name="QuickBoostBtnIcon" Glyph="&#xE777;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock x:Name="QuickBoostBtnText" Text="بهینه‌سازی و ارتقای سرعت سیستم" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Live Cleanup & Animation Panel (During cleaning) -->
        <Border x:Name="LiveCleanupCard" Visibility="Collapsed" MinHeight="310" CornerRadius="12" Padding="20,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
            <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ProgressRing x:Name="LiveCleanSpinner" Width="20" Height="20" IsIndeterminate="True" />
                        <FontIcon x:Name="LiveCleanDoneIcon" Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="LiveCleanStatusTitle" Text="در حال پویش هوشمند سرفصل‌های سیستم..." FontWeight="SemiBold" FontSize="13.5" />
                            <TextBlock x:Name="LiveCleanPhaseSubtitle" Text="در حال پردازش گام‌به‌گام سرفصل‌ها..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="LiveFreedCounterText" Grid.Column="2" Text="+ 0 بایت آزاد شد" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                </Grid>

                <ProgressBar x:Name="LiveCleanProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" HorizontalAlignment="Stretch" />

                <!-- Sequential Item List -->
                <ListView x:Name="LiveCleanListView" SelectionMode="None" Height="220" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <!-- 3. Final Summary Report Card (After 1-click clean) -->
        <Border x:Name="CleanupReportCard" Visibility="Collapsed" CornerRadius="12" Padding="22,18" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                <!-- Report Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                            <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="گزارش نهایی و سلسله‌مراتبی بهینه‌سازی سیستم" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="عملیات با موفقیت پایان یافت؛ جزئیات سرفصل‌ها و تغییرات اعمال‌شده در زیر آمده است:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock x:Name="ReportTotalFreedText" Text="+ 0 بایت آزاد شد" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>
                </Grid>

                <!-- Divider Line -->
                <Border Height="1" Background="{ThemeResource AppHeaderBorderBrush}" HorizontalAlignment="Stretch" />

                <!-- Hierarchical Tree Container -->
                <StackPanel x:Name="ReportGroupsContainer" Spacing="12" HorizontalAlignment="Stretch" />

                <!-- Footer Actions -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <TextBlock Text="فایل‌های موقت با موفقیت پاکسازی شدند و به اطلاعات شخصی آسیبی نرسید." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    <Button x:Name="CloseReportBtn" Style="{ThemeResource AccentButtonStyle}" Padding="20,8" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                            <TextBlock Text="تأیید و بازگشت به داشبورد" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. Bento Status Grid (RAM, Disk, CPU) -->
        <Grid x:Name="BentoGrid" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="12" HorizontalAlignment="Stretch">
            <!-- RAM Card -->
            <Border x:Name="BentoRamCard" Grid.Column="0" CornerRadius="12" Padding="18,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="26" Height="26" CornerRadius="6" Background="#1A3B82F6">
                                <FontIcon Glyph="&#xE9D2;" FontSize="13" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="CardRamTitle" Text="حافظه رم (RAM)" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="CardRamStatusBadge" Grid.Column="1" Background="#1810B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="CardRamStatusText" Text="وضعیت روان" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                        </Border>
                    </Grid>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="CardRamText" Text="-- / --" FontSize="19" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="فضای مصرفی در حال حاضر" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressBar x:Name="CardRamProgress" Minimum="0" Maximum="100" Value="0" Height="5" CornerRadius="3" HorizontalAlignment="Stretch" Foreground="#3B82F6" />
                    <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                        <Border Background="{ThemeResource AppCardSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,3,0">
                            <TextBlock x:Name="CardRamAvailableText" Text="در دسترس: --" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource AppCardSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="3,0,0,0">
                            <TextBlock x:Name="CardRamTotalBadge" Text="مجموع: --" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Drive C: Card -->
            <Border x:Name="BentoDiskCard" Grid.Column="1" CornerRadius="12" Padding="18,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="26" Height="26" CornerRadius="6" Background="#1A10B981">
                                <FontIcon Glyph="&#xEDA2;" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="CardDiskTitle" Text="دیسک سیستم (Drive :C)" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="CardDiskHealthBadge" Grid.Column="1" Background="#1810B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="CardDiskHealthText" Text="سالم (Healthy)" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                        </Border>
                    </Grid>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="CardDiskText" Text="-- آزاد از --" FontSize="19" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="فضای ذخیره‌سازی درایو اصلی" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressBar x:Name="CardDiskProgress" Minimum="0" Maximum="100" Value="0" Height="5" CornerRadius="3" HorizontalAlignment="Stretch" Foreground="#10B981" />
                    <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                        <Border Background="{ThemeResource AppCardSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,3,0">
                            <TextBlock x:Name="CardDiskTypeBadge" Text="NVMe SSD" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource AppCardSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="3,0,0,0">
                            <TextBlock Text="فایل‌سیستم: NTFS" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CPU & Hardware Card -->
            <Border x:Name="BentoCpuCard" Grid.Column="2" CornerRadius="12" Padding="18,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="26" Height="26" CornerRadius="6" Background="#1A8B5CF6">
                                <FontIcon Glyph="&#xE770;" FontSize="13" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="CardCpuTitle" Text="پردازنده و سخت‌افزار" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="CardPowerBadge" Grid.Column="1" Background="{ThemeResource AppHeaderPillBrush}" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="CardPowerText" Text="متصل به برق" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </Grid>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="CardCpuText" Text="مصرف CPU: 0%" FontSize="19" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="بار پردازشی هسته‌های سیستم" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ProgressBar x:Name="CardCpuProgress" Minimum="0" Maximum="100" Value="0" Height="5" CornerRadius="3" HorizontalAlignment="Stretch" Foreground="#8B5CF6" />
                    <Grid ColumnDefinitions="*,*" Margin="0,2,0,0">
                        <Border Background="{ThemeResource AppCardSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,3,0">
                            <TextBlock x:Name="CardGpuSummaryText" Text="گرافیک فعال" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource AppCardSecondaryBrush}" CornerRadius="6" Padding="8,4" Margin="3,0,0,0">
                            <TextBlock Text="معماری ۶۴ بیتی" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5. Advanced Cleaning Items Expander (Custom selection) -->
        <Border CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Margin="0,4,0,0">
            <Expander x:Name="AdvancedCleanExpander" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="AdvancedCleanExpanderTitle" Text="سفارشی‌سازی موارد پاکسازی (تنظیمات پیشرفته دیسک و برنامه‌ها)" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AdvancedCleanTotalText" Grid.Column="2" Text="بررسی نشده" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>

                <Expander.Content>
                    <StackPanel x:Name="AdvancedGroupsContainer" Spacing="10" Padding="8,12" HorizontalAlignment="Stretch" />
                </Expander.Content>
            </Expander>
        </Border>

        <!-- Status InfoBar -->
        <InfoBar x:Name="StatusInfoBar" IsOpen="False" Severity="Success" IsClosable="True" Margin="0,8,0,0" />
    </StackPanel>
    </Grid>
</ScrollViewer>
