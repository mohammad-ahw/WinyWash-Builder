<!-- ============================================================================== -->
<!-- CleanC UI Section 09: Windows Update Manager Full Page                        -->
<!-- ============================================================================== -->
<StackPanel x:Name="ToolWindowsUpdatePanel" Spacing="16" Visibility="Visible" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <!-- Top Bar -->
    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Button Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="مدیریت و کنترل بروزرسانی‌های ویندوز (Windows Update)" FontSize="16" FontWeight="Bold" LineHeight="24" />
                <TextBlock Text="بررسی آپدیت‌های در انتظار، توقف ۵ هفته‌ای رسمی، تغییر وضعیت سرویس و رفع گیر کردن دانلود" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
            </StackPanel>
        </StackPanel>

        <Button Grid.Column="1" Height="36" Padding="16,0" CornerRadius="8" Style="{ThemeResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                <TextBlock Text="بررسی آپدیت‌های جدید" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </Button>
    </Grid>

    <!-- Status Overview Banner -->
    <Border CornerRadius="12" Padding="20,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Border Width="48" Height="48" CornerRadius="12" Background="#1A0284C7" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE895;" FontSize="22" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="UpdateStatusHeadlineText" Text="وضعیت آپدیت‌های سیستم‌عامل" FontSize="14" FontWeight="Bold" />
                <TextBlock x:Name="UpdatePauseDetailText" Text="وضعیت توقف: آپدیت‌ها طبق روند معمول سیستم‌عامل دریافت می‌شوند." FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="UpdateServiceDetailText" Text="وضعیت سرویس Windows Update: فعال و آماده‌به‌کار" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>

    <!-- 3 Quick Action Cards -->
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <!-- Card 1: Official 5-Week Pause -->
        <Border Grid.Column="0" CornerRadius="10" Padding="16,14" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1AF59E0B" Margin="0,0,10,0">
                        <FontIcon Glyph="&#xE769;" FontSize="15" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="توقف / ادامه آپدیت‌ها" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="توقف رسمی تا ۵ هفته" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="توقف دریافت بسته‌های آپدیت تا ۵ هفته آینده مطابق مکانیزم رسمی تنظیمات ویندوز." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Height="34" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Content="توقف ۵ هفته‌ای" Height="32" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" />
                    <Button Content="ادامه دریافت" Grid.Column="1" Height="32" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Card 2: Update Service State -->
        <Border Grid.Column="1" CornerRadius="10" Padding="16,14" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1A8B5CF6" Margin="0,0,10,0">
                        <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="سرویس ویندوز آپدیت" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="تنظیم وضعیت wuauserv" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="تغییر نحوه اجرای سرویس در رجیستری و خاموش کردن کامل آن برای جلوگیری از هرگونه مصرف پس‌زمینه." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Height="34" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Content="غیرفعال‌سازی سرویس" Height="32" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" />
                    <Button Content="فعال‌سازی سرویس" Grid.Column="1" Height="32" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Card 3: Fix Stuck Updates & Cache Flush -->
        <Border Grid.Column="2" CornerRadius="10" Padding="16,14" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#1A10B981" Margin="0,0,10,0">
                        <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="رفع گیر کردن و خطاها" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="تخلیه کامل کش آپدیت" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="توقف موقت سرویس‌ها، پاکسازی فایل‌های معیوب در SoftwareDistribution و شروع مجدد." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Height="34" />
                <Button Content="رفع گیر کردن و پاکسازی کش" Height="32" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" Background="#10B981" Foreground="White" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Pending Updates Section -->
    <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
            <TextBlock Text="آپدیت‌های در انتظار نصب" FontSize="13.5" FontWeight="SemiBold" />
            <TextBlock x:Name="PendingUpdatesCountText" Grid.Column="1" Text="۱ مورد" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ProgressRing x:Name="UpdatesLoadingSpinner" IsActive="False" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed" />
        
        <!-- Pending Updates Container: Host for CreatePendingUpdateCard items (including Next-Gen purple upgrade cards) -->
        <StackPanel x:Name="PendingUpdatesContainer" Spacing="8" />

        <Border x:Name="NoUpdatesBanner" Visibility="Collapsed" CornerRadius="10" Padding="20,16" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="#10B981" />
                <TextBlock Text="هیچ آپدیت معلق یا در انتظار نصبی یافت نشد. ویندوز کاملاً بروز است." FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</StackPanel>
