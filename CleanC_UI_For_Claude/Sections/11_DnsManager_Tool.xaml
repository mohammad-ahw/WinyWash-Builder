<!-- ============================================================================== -->
<!-- CleanC UI Section 11: Smart DNS & Anti-Sanction Switcher Tool Full Page       -->
<!-- ============================================================================== -->
<StackPanel x:Name="ToolDnsPanel" Spacing="16" Visibility="Visible" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <!-- Top Bar -->
    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Button Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="تنظیم هوشمند DNS و تحریم‌شکن‌های قانونی" FontSize="16" FontWeight="Bold" LineHeight="24" />
                <TextBlock Text="عبور مطمئن از تحریم‌های توسعه‌دهندگان، داکر، انویدیا، ادوبی، گیمینگ و کاهش پینگ اتصال" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
            </StackPanel>
        </StackPanel>

        <Button x:Name="ResetDnsDhcpBtn" Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE777;" FontSize="13" />
                <TextBlock Text="ریست به خودکار (DHCP)" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
        </Button>
    </Grid>

    <!-- Active DNS Status Card -->
    <Border CornerRadius="12" Padding="20,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
            <Border Width="38" Height="38" CornerRadius="10" Background="#1A06B6D4" Margin="0,0,14,0" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="#06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="دی‌ان‌اس فعال در حال حاضر سیستم:" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="ActiveDnsNameText" Text="الکترو (Electro DNS)" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ActiveDnsIpText" Text="(78.157.42.100 - 78.157.42.101)" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Content="تخلیه کش DNS" Height="32" Padding="12,0" CornerRadius="6" FontSize="11.5" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
        </Grid>
    </Border>

    <!-- Presets Container Header -->
    <TextBlock Text="پروژه‌ها و سرویس‌های آماده تحریم‌شکن و دی‌ان‌اس‌های پرسرعت جهانی" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
    
    <!-- Presets Container: Host for CreateDnsPresetCard items -->
    <StackPanel x:Name="DnsPresetsContainer" Spacing="8" />
</StackPanel>
