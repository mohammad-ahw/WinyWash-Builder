<!-- ============================================================================== -->
<!-- CleanC UI Section 03: System Tools Launcher Hub (Categorized Grid)             -->
<!-- ============================================================================== -->
<StackPanel x:Name="ToolsLauncherPanel" Spacing="16" Visibility="Visible" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <TextBlock x:Name="ToolsHeaderTitle" Text="ابزارهای پیشرفته و عیب‌یابی سیستم‌عامل ویندوز" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

    <!-- Section 1: Information, Diagnostics & Testing -->
    <TextBlock Text="اطلاعات، پایش و تست سخت‌افزار" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <!-- Card 1: System Specs -->
        <Border Grid.Column="0" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="system_specs" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#3B82F6" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE770;" FontSize="18" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="مشخصات سیستم" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="CPU، رم، گرافیک، مادربرد، لایسنس و دیسک" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>

        <!-- Card 2: Speed Test -->
        <Border Grid.Column="1" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="speed_test" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#10B981" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="تست سرعت اینترنت" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="سنجش دانلود واقعی، آپلود، پینگ و ISP" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>

        <!-- Card 3: Personalization & Graphics -->
        <Border Grid.Column="2" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="personalization" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#8B5CF6" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="استایل و گرافیک" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="تم، شفافیت، رنگ و انیمیشن‌ها" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>
    </Grid>

    <!-- Section 2: Management & Maintenance -->
    <TextBlock Text="مدیریت، نگهداری و بهینه‌سازی سیستم" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" />
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <!-- Card 4: App Uninstaller -->
        <Border Grid.Column="0" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="app_uninstaller" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#EF4444" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="حذف نرم‌افزارها" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="لیست برنامه‌ها به ترتیب تاریخ نصب و حذف آسان" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>

        <!-- Card 5: Driver Manager -->
        <Border Grid.Column="1" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="drivers" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#0D9488" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE772;" FontSize="18" Foreground="#0D9488" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="مدیریت درایورها" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="عیب‌یابی، پاکسازی DriverStore و آپدیت" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>

        <!-- Card 6: Startup Manager -->
        <Border Grid.Column="2" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="startup_manager" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#F59E0B" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE7B5;" FontSize="18" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="برنامه‌های استارتاپ" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="مدیریت برنامه‌های شروع خودکار و سرعت بوت" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>
    </Grid>

    <!-- Section 3: Updates & System Tools -->
    <TextBlock Text="بروزرسانی و ابزارهای سیستمی ویندوز" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" />
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <!-- Card 7: Windows Update Manager -->
        <Border Grid.Column="0" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="windows_update" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#0284C7" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE895;" FontSize="18" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="آپدیت ویندوز" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="بررسی، توقف ۵ هفته‌ای و رفع گیر کردن دانلود" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>

        <!-- Card 8: Task Manager Quick Launch -->
        <Border Grid.Column="1" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="taskmgr" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#EA580C" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE9D2;" FontSize="18" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Task Manager" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="پایش پردازش‌ها، رم، دیسک و بستن برنامه‌ها" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>

        <!-- Card 9: Device Manager Quick Launch -->
        <Border Grid.Column="2" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="devmgmt" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#6366F1" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE772;" FontSize="18" Foreground="#6366F1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Device Manager" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="مشاهده پورت‌ها و سخت‌افزارهای سیستم" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>
    </Grid>

    <!-- Section 4: Advanced Network & Privacy Optimization -->
    <TextBlock Text="شبکه، حریم خصوصی و بهینه‌سازی پیشرفته" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,10,0,0" />
    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
        <!-- Card 10: DNS & Anti-Sanction Switcher -->
        <Border Grid.Column="0" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="dns_manager" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#06B6D4" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE774;" FontSize="18" Foreground="#06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="تنظیم DNS و تحریم‌شکن" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="شکن، الکترو، ۴۰۳ آنلاین، رادار و کلودفلر" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>

        <!-- Card 11: Privacy & Telemetry Debloater -->
        <Border Grid.Column="1" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
            <Button Tag="privacy_debloat" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="20,18" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border.Background>
                            <SolidColorBrush Color="#10B981" Opacity="0.15" />
                        </Border.Background>
                        <FontIcon Glyph="&#xE8F8;" FontSize="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="حریم خصوصی و ضدجاسوسی" FontWeight="SemiBold" FontSize="13.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="قطع تلمتری، تبلیغات و سرچ بینگ استارت" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </Border>
    </Grid>
</StackPanel>
