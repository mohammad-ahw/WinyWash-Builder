                                        <ComboBox x:Name="UninstallerSortBox" SelectionChanged="UninstallerSortBox_SelectionChanged" Height="34" CornerRadius="6">
                                            <ComboBoxItem Content="جدیدترین نصب" IsSelected="True" />
                                            <ComboBoxItem Content="بیشترین حجم" />
                                            <ComboBoxItem Content="نام (الفبا)" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Batch Action Bar -->
                                <Border x:Name="UninstallerBatchBar" Visibility="Collapsed" CornerRadius="10" Padding="14,10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <CheckBox x:Name="UninstallerSelectAllCheck" Content="انتخاب همه" FontSize="12" VerticalAlignment="Center" Checked="UninstallerSelectAll_Checked" Unchecked="UninstallerSelectAll_Unchecked" />
                                        <TextBlock x:Name="UninstallerSelectedCountText" Grid.Column="1" Text="۰ برنامه انتخاب شده" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <Button x:Name="UninstallerBatchDeleteBtn" Grid.Column="2" Click="UninstallerBatchDeleteBtn_Click" Height="34" Padding="16,0" CornerRadius="6" Style="{ThemeResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                <TextBlock x:Name="UninstallerBatchDeleteBtnText" Text="حذف برنامه‌های انتخاب‌شده" FontSize="11.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <ProgressRing x:Name="UninstallerLoadingSpinner" IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,32,0,0" />
                                <StackPanel x:Name="UninstallerAppsStack" Spacing="8" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 3: Internet Speed Test Full Page           -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolSpeedTestPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="*" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="تست سرعت واقعی اینترنت و پینگ" FontSize="16" FontWeight="Bold" LineHeight="24" />
                                            <TextBlock Text="سنجش دقیق پهنای باند دانلود، سرعت آپلود و تاخیر شبکه از سرورهای جهانی Cloudflare" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Network Metadata Chips Bar -->
                                <Border CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <!-- IP Chip -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#1A3B82F6">
                                                <FontIcon Glyph="&#xE838;" FontSize="13" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="آدرس آی‌پی (IP)" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="SpeedIpChipText" Text="--.--.--.--" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ISP Chip -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#1A10B981">
                                                <FontIcon Glyph="&#xEC27;" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="ارائه‌دهنده اینترنت (ISP)" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="SpeedIspChipText" Text="درحال شناسایی..." FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Location Chip -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#1AF59E0B">
                                                <FontIcon Glyph="&#xE819;" FontSize="13" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="موقعیت اتصال" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="SpeedLocationChipText" Text="درحال شناسایی..." FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Central Speed Gauge -->
                                <Border CornerRadius="14" Padding="28,24" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" Translation="0,0,16" Shadow="{StaticResource SharedCardShadow}">
                                    <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                                        <!-- Phase Status Badge (Decoupled from gauge circle) -->
                                        <Border HorizontalAlignment="Center" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18,7">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="SpeedGaugePhaseText" Text="آماده شروع تست سرعت" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Speed Gauge Dial -->
                                        <Grid Width="250" Height="250" HorizontalAlignment="Center">
                                            <!-- Background Circular Track -->
                                            <Ellipse Width="240" Height="240" Stroke="{ThemeResource AppCardSecondaryBrush}" StrokeThickness="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <!-- WinUI ProgressRing as Gauge Meter -->
                                            <ProgressRing x:Name="SpeedGaugeRing" Width="240" Height="240" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <!-- Inside Gauge Content -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                                <TextBlock x:Name="SpeedGaugeValueText" Text="۰.۰" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="Mbps" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" Margin="0,-4,0,6" />
                                                <Border Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="SpeedGaugeMBsText" Text="۰.۰۰ مگابایت بر ثانیه" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 3 Stat Cards Below Gauge (Ping, Download, Upload) -->
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                            <!-- Ping -->
                                            <Border Grid.Column="0" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#F59E0B" BorderThickness="0,0,0,3">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE916;" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                        <TextBlock Text="تاخیر پینگ (Ping)" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="SpeedPingValText" Text="-- ms" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Download Speed -->
                                            <Border Grid.Column="1" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#10B981" BorderThickness="0,0,0,3">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="#10B981" VerticalAlignment="Center" />
                                                        <TextBlock Text="سرعت دانلود" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="SpeedDownloadValText" Text="-- Mbps" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Upload Speed -->
                                            <Border Grid.Column="2" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#3B82F6" BorderThickness="0,0,0,3">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="#3B82F6" VerticalAlignment="Center" />
                                                        <TextBlock Text="سرعت آپلود" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="SpeedUploadValText" Text="-- Mbps" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                            <Button x:Name="StartSpeedTestBtn" Click="StartSpeedTestBtn_Click" Style="{ThemeResource AccentButtonStyle}" Height="42" Padding="28,0" CornerRadius="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                                                    <TextBlock Text="شروع تست سرعت" FontSize="13" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="StopSpeedTestBtn" Click="StopSpeedTestBtn_Click" IsEnabled="False" Height="42" Padding="22,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE71A;" FontSize="14" Foreground="#EF4444" />
                                                    <TextBlock Text="توقف تست" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 4: Windows Personalization Full Page       -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolPersonalizationPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="*" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="استایل، تم و گرافیک ویندوز" FontSize="16" FontWeight="Bold" LineHeight="24" />
                                            <TextBlock Text="شخصی‌سازی ظاهر، تم و انیمیشن‌های ویندوز با اعمال آنی بدون نیاز به ریستارت" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="PersonalizationCardsContainer" Spacing="10" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 5: Startup Manager Full Page               -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolStartupManagerPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="مدیریت برنامه‌های شروع خودکار (Startup)" FontSize="16" FontWeight="Bold" LineHeight="24" />
                                            <TextBlock x:Name="StartupManagerSummaryText" Text="غیرفعال‌سازی ایمن و بازگشت‌پذیر برنامه‌هایی که هنگام روشن شدن ویندوز اجرا می‌شوند" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1" Click="RefreshStartupManager_Click" Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock Text="بروزرسانی لیست" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel x:Name="StartupCardsContainer" Spacing="10" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 6: Windows Update Manager Full Page        -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolWindowsUpdatePanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="مدیریت و کنترل بروزرسانی‌های ویندوز (Windows Update)" FontSize="16" FontWeight="Bold" LineHeight="24" />
                                            <TextBlock Text="بررسی آپدیت‌های در انتظار، توقف ۵ هفته‌ای رسمی، تغییر وضعیت سرویس و رفع گیر کردن دانلود" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1" Click="CheckUpdatesBtn_Click" Height="36" Padding="16,0" CornerRadius="8" Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock Text="بررسی آپدیت‌های جدید" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Status Overview Banner -->
                                <Border CornerRadius="12" Padding="20,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Translation="0,0,16" Shadow="{StaticResource SharedCardShadow}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                        <Border Width="48" Height="48" CornerRadius="12" Background="#1A0284C7" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE895;" FontSize="22" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock x:Name="UpdateStatusHeadlineText" Text="وضعیت آپدیت‌های سیستم‌عامل" FontSize="14" FontWeight="Bold" />
                                            <TextBlock x:Name="UpdatePauseDetailText" Text="وضعیت توقف: آپدیت‌ها طبق روند معمول سیستم‌عامل دریافت می‌شوند." FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="UpdateServiceDetailText" Text="وضعیت سرویس Windows Update: فعال و آماده‌به‌کار" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 3 Quick Action Cards -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                    <!-- Card 1: Official 5-Week Pause -->
                                    <Border Grid.Column="0" CornerRadius="10" Padding="16,14" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="#1AF59E0B" Margin="0,0,10,0">
                                                    <FontIcon Glyph="&#xE769;" FontSize="15" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="توقف / ادامه آپدیت‌ها" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="توقف رسمی تا ۵ هفته" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="توقف دریافت بسته‌های آپدیت تا ۵ هفته آینده مطابق مکانیزم رسمی تنظیمات ویندوز." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Height="34" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Button x:Name="PauseUpdatesBtn" Click="PauseUpdatesBtn_Click" Content="توقف ۵ هفته‌ای" Height="32" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" />
                                                <Button x:Name="ResumeUpdatesBtn" Click="ResumeUpdatesBtn_Click" Content="ادامه دریافت" Grid.Column="1" Height="32" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Update Service State -->
                                    <Border Grid.Column="1" CornerRadius="10" Padding="16,14" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="#1A8B5CF6" Margin="0,0,10,0">
                                                    <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="سرویس ویندوز آپدیت" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="تنظیم وضعیت wuauserv" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="تغییر نحوه اجرای سرویس در رجیستری و خاموش کردن کامل آن برای جلوگیری از هرگونه مصرف پس‌زمینه." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Height="34" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Button x:Name="DisableUpdateServiceBtn" Click="DisableUpdateServiceBtn_Click" Content="غیرفعال‌سازی سرویس" Height="32" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" />
                                                <Button x:Name="EnableUpdateServiceBtn" Click="EnableUpdateServiceBtn_Click" Content="فعال‌سازی سرویس" Grid.Column="1" Height="32" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: Fix Stuck Updates & Cache Flush -->
                                    <Border Grid.Column="2" CornerRadius="10" Padding="16,14" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="#1A10B981" Margin="0,0,10,0">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="رفع گیر کردن و خطاها" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="تخلیه کامل کش آپدیت" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="توقف موقت سرویس‌ها، پاکسازی فایل‌های معیوب در SoftwareDistribution و شروع مجدد." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Height="34" />
                                            <Button x:Name="FixStuckUpdatesBtn" Click="FixStuckUpdatesBtn_Click" Content="رفع گیر کردن و پاکسازی کش" Height="32" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Stretch" CornerRadius="6" Background="#10B981" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Pending Updates Section -->
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                        <TextBlock Text="آپدیت‌های در انتظار نصب" FontSize="13.5" FontWeight="SemiBold" />
                                        <TextBlock x:Name="PendingUpdatesCountText" Grid.Column="1" Text="۰ مورد" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>

                                    <ProgressRing x:Name="UpdatesLoadingSpinner" IsActive="False" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed" />
                                    <StackPanel x:Name="PendingUpdatesContainer" Spacing="8" />

                                    <Border x:Name="NoUpdatesBanner" Visibility="Collapsed" CornerRadius="10" Padding="20,16" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="#10B981" />
                                            <TextBlock Text="هیچ آپدیت معلق یا در انتظار نصبی یافت نشد. ویندوز کاملاً بروز است." FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 7: Driver Manager Full Page                -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolDriversPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="مدیریت و پاکسازی درایورهای ویندوز (Driver Manager)" FontSize="16" FontWeight="Bold" LineHeight="24" />
                                            <TextBlock Text="شناسایی کدهای خطای سخت‌افزاری، پاکسازی ایمن نسخه‌های تکراری DriverStore و آپدیت درایورها" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CheckDriverUpdatesBtn" Click="CheckDriverUpdatesBtn_Click" Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE895;" FontSize="13" Foreground="#0284C7" />
                                                <TextBlock Text="بررسی آپدیت درایورها" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="RefreshDrivers_Click" Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock Text="بروزرسانی لیست" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Summary Stats Banner (3 Columns) -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                    <Border CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#3B82F6" BorderThickness="0,0,0,3">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="کل بسته‌های درایور" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DriversTotalCountText" Text="-- بسته" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#EF4444" BorderThickness="0,0,0,3">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="خطاهای سخت‌افزاری" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DriversErrorCountText" Text="۰ خطا" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#F59E0B" BorderThickness="0,0,0,3">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="نسخه‌های تکراری قدیمی" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DriversDuplicateCountText" Text="۰ بسته" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Duplicate Cleanup Action Banner (Visible when duplicates > 0) -->
                                <Border x:Name="DriversDuplicateBanner" Visibility="Collapsed" CornerRadius="10" Padding="18,14" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="#F59E0B" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center" Spacing="3">
                                            <TextBlock x:Name="DriversDuplicateBannerTitle" Text="پاکسازی بسته‌های تکراری و اشغال‌کننده فضای سیستم" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="این درایورها نسخه‌های قدیمی‌تر هستند که با نصب نسخه جدید جایگزین شده‌اند و با ایجاد Restore Point به صورت ایمن حذف می‌شوند." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button x:Name="CleanOldDriversBtn" Click="CleanOldDriversBtn_Click" Grid.Column="1" Content="پاکسازی درایورهای قدیمی DriverStore" Height="34" CornerRadius="8" FontWeight="SemiBold" FontSize="11.5" Style="{ThemeResource AccentButtonStyle}" />
                                    </Grid>
                                </Border>

                                <!-- Drivers Batch Selection & Deletion Bar -->
                                <Border x:Name="DriversBatchBar" Visibility="Collapsed" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <CheckBox x:Name="DriversSelectAll" Checked="DriversSelectAll_Checked" Unchecked="DriversSelectAll_Unchecked" Content="انتخاب همه درایورها" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock x:Name="DriversSelectedCountText" Grid.Column="1" Text="۰ درایور انتخاب شده" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" />
                                        <Button x:Name="DriversBatchDeleteBtn" Grid.Column="2" Click="DriversBatchDeleteBtn_Click" Height="34" CornerRadius="6" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Padding="16,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                <TextBlock x:Name="DriversBatchDeleteBtnText" Text="حذف درایورهای انتخاب‌شده" FontSize="11.5" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Search / Filter -->
                                <AutoSuggestBox x:Name="DriversSearchBox" PlaceholderText="جستجو در بین درایورها..." QueryIcon="Find" Height="36" TextChanged="DriversSearchBox_TextChanged" />

                                <!-- Driver Items List -->
                                <ProgressRing x:Name="DriversLoadingSpinner" IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,24,0,0" />
                                <StackPanel x:Name="DriversCardsContainer" Spacing="8" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 8: Smart DNS & Anti-Sanction Switcher       -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolDnsPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="تنظیم هوشمند DNS و تحریم‌شکن‌های قانونی" FontSize="16" FontWeight="Bold" LineHeight="24" />
                                            <TextBlock Text="عبور مطمئن از تحریم‌های توسعه‌دهندگان، داکر، انویدیا، ادوبی، گیمینگ و کاهش پینگ اتصال" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button x:Name="ResetDnsDhcpBtn" Click="ResetDnsDhcpBtn_Click" Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE777;" FontSize="13" />
                                            <TextBlock Text="ریست به خودکار (DHCP)" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Active DNS Status Card -->
                                <Border CornerRadius="12" Padding="20,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                        <Border Width="38" Height="38" CornerRadius="10" Background="#1A06B6D4" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="#06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="دی‌ان‌اس فعال در حال حاضر سیستم:" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="ActiveDnsNameText" Text="در حال بررسی..." FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="ActiveDnsIpText" Text="" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Click="FlushDnsQuickBtn_Click" Content="تخلیه کش DNS" Height="32" Padding="12,0" CornerRadius="6" FontSize="11.5" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
                                    </Grid>
                                </Border>

                                <!-- Presets Container -->
                                <TextBlock Text="پروژه‌ها و سرویس‌های آماده تحریم‌شکن و دی‌ان‌اس‌های پرسرعت جهانی" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                                <StackPanel x:Name="DnsPresetsContainer" Spacing="8" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 9: Windows 11 Context Menu Manager          -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolContextMenuPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="*" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="مدیریت منوی کلیک‌راست ویندوز ۱۱ (Context Menu)" FontSize="16" FontWeight="Bold" LineHeight="24" />
                                            <TextBlock Text="تغییر ظاهر منوی راست‌کلیک میان استایل مدرن ویندوز ۱۱ و استایل کلاسیک سریع ویندوز ۱۰" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Toggle Card -->
                                <Border CornerRadius="12" Padding="22,18" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="حالت منوی کلاسیک کامل (ویندوز ۱۰ بدون Show more options)" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="با فعال‌سازی این گزینه، تمام گزینه‌های برنامه‌ها مانند WinRAR، 7-Zip و Visual Studio با یک کلیک مستقیم و بدون نیاز به فشردن Shift یا Show More ظاهر می‌شوند." FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ClassicMenuToggle" Grid.Column="1" Toggled="ClassicMenuToggle_Toggled" OnContent="کلاسیک (سریع)" OffContent="مدرن ویندوز ۱۱" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Explorer Restart Helper Card -->
                                <Border CornerRadius="12" Padding="20,16" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="راه‌اندازی مجدد فرآیند Windows Explorer" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="در صورتی که منو بلافاصله اعمال نشد، با ریست اکسپلورر تغییرات در کسری از ثانیه فعال می‌شوند." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Click="RestartExplorerBtn_Click" Content="ریست اکسپلورر" Height="34" Padding="16,0" CornerRadius="6" FontWeight="SemiBold" FontSize="11.5" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 10: Windows 11 Privacy & Debloater         -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolPrivacyPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="حریم خصوصی و حذف تلمتری ویندوز ۱۱ (Privacy Debloater)" FontSize="16" FontWeight="Bold" LineHeight="24" />
                                            <TextBlock Text="توقف ارسال مخفیانه لاگ‌ها و دیتاها به سرورهای مایکروسافت و افزایش سرعت عملکرد سیستم" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button x:Name="ApplyPrivacyDebloatBtn" Click="ApplyPrivacyDebloatBtn_Click" Style="{ThemeResource AccentButtonStyle}" Height="36" Padding="16,0" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8F8;" FontSize="13" />
                                            <TextBlock Text="اعمال تمامی بهینه‌سازی‌های امنیتی" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Privacy Options Cards -->
                                <StackPanel Spacing="10">
                                    <Border CornerRadius="10" Padding="18,14" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="#10B981" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="قطع تلمتری و گزارش عملکرد (DiagTrack)" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="غیرفعال‌سازی سرویس Connected User Experiences and Telemetry و توقف ارسال بسته‌های پس‌زمینه" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock x:Name="PrivacyDiagTrackStatus" Grid.Column="2" Text="محافظت‌شده ✓" Foreground="#10B981" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border CornerRadius="10" Padding="18,14" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <FontIcon Glyph="&#xE721;" FontSize="16" Foreground="#0284C7" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="حذف جستجوی وب بینگ از استارت منو (Bing Search)" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="جلوگیری از ارسال متن جستجوی شما به اینترنت و افزایش چشمگیر سرعت باز شدن جستجوی فایل‌ها" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="بهینه‌سازی فعال ✓" Grid.Column="2" Foreground="#0284C7" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border CornerRadius="10" Padding="18,14" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <FontIcon Glyph="&#xE719;" FontSize="16" Foreground="#F59E0B" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="غیرفعال‌سازی شناسه تبلیغاتی ویندوز (Advertising ID)" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="جلوگیری از ساخت پروفایل کاربری تبلیغاتی توسط اپلیکیشن‌های استور مایکروسافت" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="مسدود شده ✓" Grid.Column="2" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <Border CornerRadius="10" Padding="18,14" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <FontIcon Glyph="&#xE81C;" FontSize="16" Foreground="#8B5CF6" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="توقف ثبت تاریخچه فعالیت‌ها (Activity History)" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="توقف جمع‌آوری سوابق باز کردن برنامه‌ها، مرور وب و فایل‌ها توسط ویندوز" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="ایمن ✓" Grid.Column="2" Foreground="#8B5CF6" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        <!-- Global Floating Toast Notification (Appears seamlessly over ANY active view) -->
        <Border x:Name="FloatingToastCard"
                Grid.Row="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Canvas.ZIndex="999"
                Margin="0,16,0,0"
                Padding="16,10,14,10"
                CornerRadius="12"
                Background="{ThemeResource AppToastBackgroundBrush}"
                BorderBrush="{ThemeResource AppToastBorderBrush}"
                BorderThickness="1"
                Translation="0,0,32"
                Shadow="{StaticResource SharedCardShadow}"
                MaxWidth="560"
                Visibility="Collapsed"
                Opacity="0"
                FlowDirection="RightToLeft">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border x:Name="ToastIconBox" Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1A10B981" VerticalAlignment="Center" Margin="0,0,12,0">
                    <FontIcon x:Name="ToastIcon" Glyph="&#xE73E;" FontSize="13" Foreground="#10B981" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="ToastTitleText" Text="عملیات موفق" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="ToastMessageText" Text="پیام نوتیفیکیشن" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ToastCloseBtn" Click="ToastCloseBtn_Click" Grid.Column="2" Width="26" Height="26" Padding="0" Margin="12,0,0,0" Background="Transparent" BorderThickness="0" CornerRadius="13" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
