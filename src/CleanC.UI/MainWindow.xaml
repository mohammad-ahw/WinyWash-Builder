                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="UpdateRow3Title" Text="رفع گیر کردن آپدیت ها (پاکسازی کش)" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="UpdateRow3Sub" Text="توقف سرویس، پاکسازی کامل پوشه SoftwareDistribution و راه اندازی مجدد" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button x:Name="FixStuckUpdatesBtn" Click="FixStuckUpdatesBtn_Click" Content="پاکسازی کش" Height="32" FontSize="11.5" FontWeight="SemiBold" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" Grid.Column="2" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Pending Updates Section -->
                                <StackPanel Spacing="8" Margin="0,4,0,0">
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="UpdatePendingSectionTitle" Text="آپدیت های در انتظار نصب" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="PendingUpdatesCountText" Grid.Column="1" Text="۰ مورد" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>

                                    <ProgressRing x:Name="UpdatesLoadingSpinner" IsActive="False" Width="30" Height="30" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed" />
                                    <StackPanel x:Name="PendingUpdatesContainer" Spacing="6" />

                                    <Border x:Name="NoUpdatesBanner" Visibility="Collapsed" CornerRadius="10" Padding="16,14" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock x:Name="NoUpdatesBannerText" Text="هیچ آپدیت معلق یا در انتظار نصبی یافت نشد. ویندوز کاملاً بروز است." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

