                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Dynamic Privacy Cards List -->
                                <StackPanel x:Name="PrivacyCardsContainer" Spacing="6" />

                                <!-- Bulk Actions Footer -->
                                <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,0">
                                    <TextBlock x:Name="PrivacyFooterHint" Text="برای حداکثر امنیت، فعال بودن همه گزینه ها پیشنهاد می شود." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ResetPrivacyDefaultsBtn" Click="ResetPrivacyDefaultsBtn_Click" Content="پیش فرض ویندوز" Height="32" Padding="14,0" CornerRadius="6" FontSize="11.5" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
                                        <Button Click="EnableAllPrivacyProtectionsBtn_Click" Style="{ThemeResource AccentButtonStyle}" Height="32" Padding="16,0" CornerRadius="6">
                                            <TextBlock x:Name="EnableAllPrivacyProtectionsBtnText" Text="فعال سازی همه" FontSize="11.5" FontWeight="SemiBold" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 9: Deep Storage & Duplicate Cleaner Tool   -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolDeepStoragePanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Width="36" Height="36" Padding="0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <FontIcon x:Name="ToolBackIcon10" Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74C;" FontSize="17" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="DeepStorageHeaderTitle" Text="پاکسازی عمیق و سازماندهی دیسک" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="DeepStorageHeaderSubtitle" Text="شناسایی فایل های تکراری، پوشه های خالی، دانلودها، دسکتاپ و فایل های حجیم" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="DeepStorageScanBtn" Click="DeepStorageScanBtn_Click" Grid.Column="2" Style="{ThemeResource AccentButtonStyle}" Height="34" Padding="16,0" CornerRadius="6" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock x:Name="DeepStorageScanBtnText" Text="شروع پویش عمیق" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 4 Summary Metric Cards (Duplicates, Empty Folders, Mess, Large Files) -->
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                    <!-- Duplicates Stat -->
                                    <Border Grid.Column="0" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="DeepStorageDuplicatesLabel" Text="فایل های تکراری" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE8C8;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <TextBlock x:Name="DeepStorageDuplicatesCountText" Text="۰ گروه تکراری" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="DeepStorageDuplicatesSizeText" Text="۰ بایت قابل آزادسازی" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Empty Folders Stat -->
                                    <Border Grid.Column="1" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="DeepStorageEmptyFoldersLabel" Text="پوشه های خالی" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <TextBlock x:Name="DeepStorageEmptyFoldersCountText" Text="۰ پوشه خالی" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="DeepStorageEmptyFoldersSub" Text="فاقد فایل یا زیرپوشه" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Mess / Downloads Stat -->
                                    <Border Grid.Column="2" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="DeepStorageMessTitleText" Text="فایل های زائد و نامرتب" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <TextBlock x:Name="DeepStorageMessCountText" Text="۰ فایل نامرتب" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="DeepStorageMessSizeText" Text="موقت، نصاب ها و زائد" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Large Files Stat -->
                                    <Border Grid.Column="3" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="DeepStorageLargeFilesLabel" Text="فایل های حجیم" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE7C3;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <TextBlock x:Name="DeepStorageLargeFilesCountText" Text="۰ فایل حجیم" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="DeepStorageLargeFilesSizeText" Text="بالاتر از ۵۰۰ مگابایت" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Category Filter Tabs & Batch Bar (2-Row Responsive Layout) -->
                                <!-- Category Filter Tabs & Batch Bar (2-Row Responsive Layout) -->
                                <Border CornerRadius="10" Padding="12,10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="10" VerticalAlignment="Center">
                                        <!-- Row 0: Filter Segmented Tabs & Sorting Controls -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button x:Name="DeepStorageTabDuplicates" Click="DeepStorageTab_Click" Tag="duplicates" Height="30" Padding="12,0" CornerRadius="6" FontSize="11" FontWeight="SemiBold" Style="{ThemeResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                                        <TextBlock x:Name="DeepStorageTabDuplicatesText" Text="فایل های تکراری" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="DeepStorageTabEmptyFolders" Click="DeepStorageTab_Click" Tag="empty_folders" Height="30" Padding="12,0" CornerRadius="6" FontSize="11" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                                                        <TextBlock x:Name="DeepStorageTabEmptyFoldersText" Text="پوشه های خالی" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="DeepStorageTabMess" Click="DeepStorageTab_Click" Tag="mess" Height="30" Padding="12,0" CornerRadius="6" FontSize="11" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE896;" FontSize="11" />
                                                        <TextBlock x:Name="DeepStorageTabMessText" Text="فایل های زائد و اضافی" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="DeepStorageTabLargeFiles" Click="DeepStorageTab_Click" Tag="large_files" Height="30" Padding="12,0" CornerRadius="6" FontSize="11" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE7C3;" FontSize="11" />
                                                        <TextBlock x:Name="DeepStorageTabLargeFilesText" Text="فایل های حجیم" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- Sorting Controls -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock x:Name="DeepStorageSortLabel" Text="مرتب سازی:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <Button x:Name="DeepStorageSortSizeBtn" Click="DeepStorageSort_Click" Tag="size" Height="28" Padding="8,0" CornerRadius="6" FontSize="10.5" Style="{ThemeResource AccentButtonStyle}">
                                                    <TextBlock x:Name="DeepStorageSortSizeBtnText" Text="حجم 🔻" />
                                                </Button>
                                                <Button x:Name="DeepStorageSortDateBtn" Click="DeepStorageSort_Click" Tag="date" Height="28" Padding="8,0" CornerRadius="6" FontSize="10.5" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                    <TextBlock x:Name="DeepStorageSortDateBtnText" Text="تاریخ 📅" />
                                                </Button>
                                                <Button x:Name="DeepStorageSortNameBtn" Click="DeepStorageSort_Click" Tag="name" Height="28" Padding="8,0" CornerRadius="6" FontSize="10.5" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                    <TextBlock x:Name="DeepStorageSortNameBtnText" Text="نام 🔤" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Batch Actions (Select All & Delete) -->
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <CheckBox x:Name="DeepStorageSelectAllCheck" Click="DeepStorageSelectAllCheck_Click" Content="انتخاب همه" FontSize="11" VerticalAlignment="Center" />
                                            <TextBlock x:Name="DeepStorageSelectedCountText" Grid.Column="1" Text="۰ مورد انتخاب شده" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <Button x:Name="DeepStorageBatchDeleteBtn" Grid.Column="2" Click="DeepStorageBatchDeleteBtn_Click" Height="30" Padding="14,0" CornerRadius="6" FontSize="11.5" FontWeight="SemiBold" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <ProgressRing x:Name="DeepStorageBatchDeleteSpinner" Width="14" Height="14" IsIndeterminate="True" Visibility="Collapsed" />
                                                    <FontIcon x:Name="DeepStorageBatchDeleteIcon" Glyph="&#xE74D;" FontSize="11" />
                                                    <TextBlock x:Name="DeepStorageBatchDeleteBtnText" Text="پاکسازی موارد انتخابی" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Loading Panel -->
                                <Border x:Name="DeepStorageLoadingPanel" Visibility="Collapsed" CornerRadius="10" Padding="24" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressRing Width="28" Height="28" IsIndeterminate="True" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="DeepStorageScanStatusText" Text="در حال پویش عمیق ساختار فایل ها و محاسبه هش محتوا..." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Items Container -->
                                <StackPanel x:Name="DeepStorageItemsStack" Spacing="6" />


                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View: Recycle Bin Manager (F8)                  -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolRecycleBinPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Width="36" Height="36" Padding="0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <FontIcon x:Name="ToolBackIcon11" Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="17" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="RecycleBinHeaderTitle" Text="سطل بازیافت" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="RecycleBinHeaderSubtitle" Text="پیش نمایش آیتم به آیتم؛ بازگردانی یا حذف قطعی تک تک اشیاء" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="RecycleBinRefreshBtn" Click="RecycleBinRefreshBtn_Click" Grid.Column="2" Height="34" Padding="16,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock x:Name="RecycleBinRefreshBtnText" Text="تازه سازی" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Summary -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                    <Border CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="RecycleBinTotalLabel" Text="تعداد اشیاء" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE8FD;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <TextBlock x:Name="RecycleBinCountText" Text="—" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock x:Name="RecycleBinSizeLabel" Text="حجم اشغال شده" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE964;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <TextBlock x:Name="RecycleBinSizeText" Text="—" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Bulk Actions -->
                                <Border CornerRadius="10" Padding="14,10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <CheckBox x:Name="RecycleBinSelectAllCheck" Click="RecycleBinSelectAllCheck_Click" Content="انتخاب همه" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="RecycleBinSelectedCountText" Text="۰ مورد انتخاب شده" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button x:Name="RecycleBinRestoreSelectedBtn" Click="RecycleBinRestoreSelectedBtn_Click" Height="30" Padding="14,0" CornerRadius="6" FontSize="11.5" FontWeight="SemiBold" Style="{ThemeResource AccentButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE777;" FontSize="11" />
                                                    <TextBlock x:Name="RecycleBinRestoreSelectedText" Text="بازگردانی انتخاب شده ها" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="RecycleBinDeleteSelectedBtn" Click="RecycleBinDeleteSelectedBtn_Click" Height="30" Padding="14,0" CornerRadius="6" FontSize="11.5" FontWeight="SemiBold" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                                    <TextBlock x:Name="RecycleBinDeleteSelectedText" Text="حذف قطعی انتخاب شده ها" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="RecycleBinEmptyBtn" Click="RecycleBinEmptyBtn_Click" Height="30" Padding="14,0" CornerRadius="6" FontSize="11.5" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE75C;" FontSize="11" />
                                                    <TextBlock x:Name="RecycleBinEmptyBtnText" Text="خالی کردن کل سطل" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Loading -->
                                <Border x:Name="RecycleBinLoadingPanel" Visibility="Collapsed" CornerRadius="10" Padding="24" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressRing Width="28" Height="28" IsIndeterminate="True" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="RecycleBinLoadingText" Text="در حال خواندن فهرست سطل بازیافت..." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Per-item preview list (built in code) -->
                                <StackPanel x:Name="RecycleBinItemsStack" Spacing="6" />

                                <Border x:Name="RecycleBinEmptyHint" Visibility="Collapsed" CornerRadius="10" Padding="24" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE74D;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="RecycleBinEmptyHintText" Text="سطل بازیافت خالی است؛ چیزی برای بازگردانی یا حذف وجود ندارد." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ======================================================= -->
                <!-- View 3: Application Settings (D2)                       -->
                <!-- ======================================================= -->
                <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel x:Name="SettingsContentPanel" Spacing="16" HorizontalAlignment="Stretch" MaxWidth="960" Margin="24,8,24,32">

                        <StackPanel Spacing="2">
                            <TextBlock x:Name="SettingsHeaderTitle" Text="تنظیمات برنامه" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SettingsHeaderSubtitle" Text="شخصی سازی ظاهر، زبان، رفتار پس زمینه و تهیه گزارش" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <!-- 0. زبان برنامه (Language) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="SettingsLangTitle" Text="زبان برنامه (Language)" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsLangDesc" Text="انتخاب زبان رابط کاربری، جهت نوشتاری (RTL / LTR) و تایپوگرافی نیتیو سیستم عامل." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="210" VerticalAlignment="Center" SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="Auto" Content="خودکار (بر اساس ساعت و منطقه)" />
                                    <ComboBoxItem Tag="fa-IR" Content="🇮🇷 فارسی" />
                                    <ComboBoxItem Tag="en-US" Content="🇬🇧 English" />
                                    <ComboBoxItem Tag="ar-SA" Content="🇸🇦 العربية" />
                                    <ComboBoxItem Tag="zh-CN" Content="🇨🇳 简体中文" />
                                    <ComboBoxItem Tag="ja-JP" Content="🇯🇵 日本語" />
                                    <ComboBoxItem Tag="ko-KR" Content="🇰🇷 한국어" />
                                    <ComboBoxItem Tag="ru-RU" Content="🇷🇺 Русский" />
                                    <ComboBoxItem Tag="de-DE" Content="🇩🇪 Deutsch" />
                                    <ComboBoxItem Tag="fr-FR" Content="🇫🇷 Français" />
                                    <ComboBoxItem Tag="es-ES" Content="🇪🇸 Español" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- 1. ظاهر / تم (سه حالته) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="SettingsThemeTitle" Text="تم برنامه" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsThemeDesc" Text="«سیستم» از تم ویندوز پیروی می کند؛ دو حالت دیگر تم را ثابت نگه می دارند." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                    <RadioButton x:Name="ThemeSystemRadio" Content="سیستم" Click="ThemeRadio_Click" IsChecked="{x:Bind SettingsVm.IsThemeSystem, Mode=OneWay}" />
                                    <RadioButton x:Name="ThemeLightRadio" Content="روشن" Click="ThemeRadio_Click" IsChecked="{x:Bind SettingsVm.IsThemeLight, Mode=OneWay}" />
                                    <RadioButton x:Name="ThemeDarkRadio" Content="تاریک" Click="ThemeRadio_Click" IsChecked="{x:Bind SettingsVm.IsThemeDark, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 1.5. کاراکتر هیرو — همان چیزی که داخل کارت داشبورد (WebView2) رندر می شود -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SettingsCharTitle" Text="کاراکتر هیرو" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsCharDesc" Text="ظاهر، لحن و رفتار کاراکتر داخل کارت داشبورد. تغییرات بلافاصله در کارت اعمال می شود." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- لحن گفتار -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <TextBlock x:Name="CharToneText" Text="لحن گفتار" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CharToneCombo" Grid.Column="1" Width="190" VerticalAlignment="Center" SelectionChanged="CharToneCombo_SelectionChanged">
                                        <ComboBoxItem x:Name="CharToneJokeItem" Tag="joke" Content="شوخ‌طبع" />
                                        <ComboBoxItem x:Name="CharToneCalmItem" Tag="calm" Content="آرام" />
                                        <ComboBoxItem x:Name="CharToneSeriousItem" Tag="serious" Content="جدی" />
                                    </ComboBox>
                                </Grid>

                                <!-- اسم کاراکتر / اسم کاربر / شهر -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <TextBlock x:Name="CharNameText" Text="اسم کاراکتر" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBox x:Name="CharNameBox" Grid.Column="1" Width="190" MaxLength="24" Text="{x:Bind SettingsVm.CharacterName, Mode=TwoWay}" PlaceholderText="مثلاً سی‌سی" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <TextBlock x:Name="CharUserNameText" Text="اسم شما (برای سلام کردن)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBox x:Name="CharUserNameBox" Grid.Column="1" Width="190" MaxLength="24" Text="{x:Bind SettingsVm.CharacterUserName, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <TextBlock x:Name="CharCityText" Text="شهر (ماژول آب و هوا)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBox x:Name="CharCityBox" Grid.Column="1" Width="190" MaxLength="40" Text="{x:Bind SettingsVm.CharacterCity, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- شدت انیمیشن -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <TextBlock x:Name="CharIntensityText" Text="شدت انیمیشن ها" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CharIntensityCombo" Grid.Column="1" Width="190" VerticalAlignment="Center" SelectionChanged="CharIntensityCombo_SelectionChanged">
                                        <ComboBoxItem x:Name="CharIntOffItem" Tag="off" Content="خاموش" />
                                        <ComboBoxItem x:Name="CharIntLowItem" Tag="low" Content="کم" />
                                        <ComboBoxItem x:Name="CharIntMidItem" Tag="mid" Content="متوسط" />
                                        <ComboBoxItem x:Name="CharIntHighItem" Tag="high" Content="زیاد" />
                                    </ComboBox>
                                </Grid>

                                <!-- اندازه -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <TextBlock x:Name="CharSizeText" Text="اندازه کاراکتر" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Slider x:Name="CharSizeSlider" Width="170" Minimum="0.7" Maximum="1.4" StepFrequency="0.05"
                                                Value="{x:Bind SettingsVm.CharacterSize, Mode=TwoWay}"
                                                ValueChanged="CharSizeSlider_ValueChanged" />
                                        <TextBlock x:Name="CharSizeValueText" Width="38" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- اکسسوری / اکسسوری مناسبتی -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <TextBlock x:Name="CharLookText" Text="اکسسوری" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CharLookCombo" Grid.Column="1" Width="190" VerticalAlignment="Center" SelectionChanged="CharLookCombo_SelectionChanged" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <TextBlock x:Name="CharOccLookText" Text="اکسسوری مناسبتی (رویدادها)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox x:Name="CharOccLookCombo" Grid.Column="1" Width="190" VerticalAlignment="Center" SelectionChanged="CharOccLookCombo_SelectionChanged" />
                                </Grid>

                                <!-- کلیدهای رفتاری -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="CharBubbleText" Text="حباب گفتار" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="CharBubbleToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.CharacterBubble, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="CharEnvText" Text="صحنه و جلوه های محیطی پشت کاراکتر" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="CharEnvToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.CharacterEnv, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="CharSoundText" Text="صداها" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="CharSoundToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.CharacterSound, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="CharFastText" Text="عکس العمل سریع (کوتاه کردن انیمیشن ها)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="CharFastToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.CharacterFast, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="CharCalmText" Text="حالت آرام (کم تحرک، مناسب سیستم های کند)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="CharCalmToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.CharacterCalm, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- افست تقویم قمری -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <TextBlock x:Name="CharLunText" Text="تنظیم تقویم قمری برای مناسبت ها (±۱ روز)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Slider x:Name="CharLunSlider" Width="170" Minimum="-1" Maximum="1" StepFrequency="1" TickFrequency="1" IsThumbToolTipEnabled="True"
                                                ValueChanged="CharLunSlider_ValueChanged" />
                                        <TextBlock x:Name="CharLunValueText" Width="38" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. اجرا در پس زمینه و نوار وظیفه -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SettingsTrayTitle" Text="اجرا در پس زمینه و نوار وظیفه" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsTrayDesc" Text="کنترل حضور برنامه در پس زمینه و دسترسی سریع از طریق آیکون کنار ساعت ویندوز." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="SettingsCloseToTrayText" Text="با بستن پنجره خارج نشو؛ در پس زمینه (کنار ساعت) بمان" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.CloseToTray, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="SettingsMinToTrayText" Text="کوچک نمایی پنجره، برنامه را در کنار ساعت پنهان کند" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.MinimizeToTray, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2.5. شروع خودکار همراه با ویندوز (F1) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="SettingsAutoStartTitle" Text="شروع همراه با ویندوز" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsAutoStartDesc" Text="با ورود به حساب کاربری، CleanC به صورت خودکار اجرا شود. همان آیتمی که در Task Manager › Startup دیده می شود." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" IsOn="False" Toggled="AutoStartToggle_Toggled" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2.6. رفتار حذف فایل های شخصی (F3) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SettingsDeleteModeTitle" Text="رفتار حذف فایل های شخصی" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsDeleteModeDesc" Text="برای حذف تکراری ها، فایل های حجیم و سازماندهی دانلودها/دسکتاپ. کش و زباله ها همیشه قطعی حذف می شوند تا فضا واقعاً آزاد شود." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <RadioButton x:Name="DeleteModeRecycleRadio" Content="انتقال به سطل بازیافت (پیش فرض)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Checked="DeleteModeRadio_Checked" IsChecked="{x:Bind SettingsVm.IsDeleteRecycle, Mode=OneWay}" />
                                <RadioButton x:Name="DeleteModeQuarantineRadio" Content="قرنطینه ی CleanC — نگهداری در پوشه ی برنامه و قابل بازگردانی از مرکز بازیابی" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Checked="DeleteModeRadio_Checked" IsChecked="{x:Bind SettingsVm.IsDeleteQuarantine, Mode=OneWay}" />
                                <RadioButton x:Name="DeleteModePermanentRadio" Content="حذف قطعی — فوراً آزاد می شود اما قابل بازگردانی نیست" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Checked="DeleteModeRadio_Checked" IsChecked="{x:Bind SettingsVm.IsDeletePermanent, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- 3. بازیابی خودکار وضعیت (D2) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SettingsStateRestoreTitle" Text="بازیابی خودکار وضعیت" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsStateRestoreDesc" Text="هر تغییر بلافاصله ذخیره می شود و در اجرای بعدی برگردانده می شود." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="SettingsSavePlacementText" Text="اندازه و موقعیت پنجره" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="SavePlacementToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.SavePlacement, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="SettingsSaveLastViewText" Text="نمای آخر (داشبورد / ابزارها / تنظیمات)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="SaveLastViewToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.SaveLastView, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="SettingsSaveScanSelectionsText" Text="انتخاب های اسکن پاکسازی" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="SaveScanSelectionsToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.SaveScanSelections, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ResetWindowPlacementBtn" Content="بازنشانی اندازه ی پنجره" Click="ResetWindowPlacementBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12" />
                                    <Button x:Name="ResetAllSettingsBtn" Content="بازنشانی همه ی تنظیمات" Click="ResetAllSettingsBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4. اطلاعات / داده های برنامه -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="SettingsAppDataTitle" Text="داده های برنامه" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <TextBlock x:Name="SettingsAppDataPathLabel" Grid.Row="0" Text="تنظیمات:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SettingsPathText" Grid.Row="0" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <TextBlock x:Name="SettingsLogPathLabel" Grid.Row="1" Text="لاگ خطاها:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LogPathText" Grid.Row="1" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="OpenSettingsFolderBtn" Content="باز کردن پوشه ی تنظیمات" Click="OpenSettingsFolderBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12" />
                                    <Button x:Name="OpenLogFolderBtn" Content="باز کردن پوشه ی لاگ ها" Click="OpenLogFolderBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 5. خروجی گزارش (F7) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SettingsExportTitle" Text="خروجی گزارش" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsExportDesc" Text="خروجی اطلاعات جامع سیستم جهت ارسال به هوش مصنوعی یا بررسی مشخصات سخت افزاری با فرمت متنی تمیز." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ExportAiReportBtn" Click="ExportAiReportBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE943;" FontSize="12" />
                                            <TextBlock x:Name="ExportAiReportText" Text="گزارش جامع برای هوش مصنوعی (.md)" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ExportSpecsTxtBtn" Click="ExportSpecsTxtBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                                            <TextBlock x:Name="ExportSpecsTxtText" Text="مشخصات کامل سیستم (.txt)" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 6. درباره (D8) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SettingsAboutTitle" Text="درباره CleanC" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsAboutDesc" Text="برای گزارش باگ، اطلاعات عیب یابی را کپی و همراه با مشکل ارسال کنید." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock x:Name="AboutVersionLabel" Grid.Row="0" Text="نسخه برنامه:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AboutVersionText" Grid.Row="0" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Text=".NET:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AboutDotNetText" Grid.Row="1" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FlowDirection="LeftToRight" />

                                    <TextBlock x:Name="AboutOsLabel" Grid.Row="2" Text="سیستم عامل:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AboutOsText" Grid.Row="2" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="CheckAppUpdatesBtn" Click="CheckAppUpdatesBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <TextBlock x:Name="CheckAppUpdatesText" Text="بررسی به روزرسانی" />
                                    </Button>
                                    <Button x:Name="OpenProjectPageBtn" Click="OpenProjectPageBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <TextBlock x:Name="OpenProjectPageText" Text="صفحه پروژه" />
                                    </Button>
                                    <Button x:Name="CopyDiagnosticsBtn" Click="CopyDiagnosticsBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <TextBlock x:Name="CopyDiagnosticsText" Text="کپی اطلاعات عیب یابی" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
