                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Status Overview Banner -->
                                <Border CornerRadius="12" Padding="16" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon x:Name="UpdateStatusIcon" Glyph="&#xE895;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                <FontIcon.RenderTransform>
                                                    <RotateTransform x:Name="UpdateStatusIconRotate" Angle="0" />
                                                </FontIcon.RenderTransform>
                                            </FontIcon>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="UpdateStatusHeadlineText" Text="وضعیت آپدیت های سیستم عامل" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="UpdatePauseDetailText" Text="آپدیت ها طبق روند معمول دریافت می شوند." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
