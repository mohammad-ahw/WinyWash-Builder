<Window
    x:Class="CleanC.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Hero="using:CleanC.UI.Hero"
    mc:Ignorable="d"
    Title="CleanC">

    <Grid RowDefinitions="Auto,*" Background="{ThemeResource WindowCanvasBrush}">
        <Grid.Resources>
            <ThemeShadow x:Key="SharedCardShadow" />
        </Grid.Resources>

        <!-- Custom Seamless WinUI 3 Title Bar (Fluent 2 elevated header with bottom separator) -->
        <Border Grid.Row="0"
                Height="54"
                Background="{ThemeResource AppHeaderBackgroundBrush}"
                BorderBrush="{ThemeResource AppHeaderBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="AppTitleBar" FlowDirection="LeftToRight" Padding="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <!-- برند + پیشوند Admin -->
                    <ColumnDefinition Width="Auto" />
                    <!-- ناحیه کشیدن پنجره (تنها ستون کششی) -->
                    <ColumnDefinition Width="*" />
                    <!-- دکمه‌های ابزار سریع هدر -->
                    <ColumnDefinition Width="Auto" />
                    <!-- جای دکمه‌های caption ویندوز -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo (Left) with Fluent 2 subtle glow & rounded elevated container -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                        <!-- Accent subtle glow border -->
                        <Border CornerRadius="9" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.25" Margin="-1" />
                        <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                            <Image Source="Assets/app-icon.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" />
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <TextBlock x:Name="AppTitleText" Text="CleanC" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccessBrush}" Margin="2,0,0,0" VerticalAlignment="Center" />
                        <Border x:Name="AdminBadge" 
                                Visibility="Collapsed" 
                                Background="{ThemeResource AdminBadgeBackgroundBrush}" 
                                BorderBrush="{ThemeResource AdminBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10" 
                                Padding="7,2" 
                                Margin="6,0,0,0" 
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7EF;" FontSize="10" Foreground="{ThemeResource AdminBadgeForegroundBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="AdminBadgeText" Text="Running as admin" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AdminBadgeForegroundBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Drag Region (Center) — فقط همین ستون برای جابه‌جایی پنجره است.
                     ناوبری اینجا نیست: به شکل pill جداگانه بالای محتوای اصلی برگشته. -->
                <Border x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent" />

                <!-- Quick Action Tools on Titlebar (Right, before caption buttons) - Pill shaped -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,12,0">
                    <Button x:Name="UndoCenterBtn" Click="UndoCenterBtn_Click" AutomationProperties.Name="مرکز بازیابی" ToolTipService.ToolTip="مرکز بازیابی و بازگشت تغییرات (Restore &amp; Undo Center)" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Width="32" Height="32" Padding="0" CornerRadius="16">
                        <FontIcon Glyph="&#xE777;" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Button>
                    <Button x:Name="RefreshStatsBtn" Click="RefreshStatsBtn_Click" AutomationProperties.Name="بروزرسانی وضعیت سیستم" ToolTipService.ToolTip="بروزرسانی وضعیت سیستم" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Width="32" Height="32" Padding="0" CornerRadius="16">
                        <FontIcon x:Name="RefreshStatsIcon" Glyph="&#xE72C;" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <Button x:Name="NotificationHistoryBtn" AutomationProperties.Name="تاریخچه عملیات و اعلان ها" ToolTipService.ToolTip="تاریخچه عملیات و اعلان ها" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Width="32" Height="32" Padding="0" CornerRadius="16">
                        <Grid>
                            <FontIcon Glyph="&#xEA8F;" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Ellipse x:Name="NotificationBadgeDot" Width="7" Height="7" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="NotificationHistoryFlyout" Placement="BottomEdgeAlignedRight">
                                <Grid Width="360" MaxHeight="450" RowDefinitions="Auto,*,Auto" FlowDirection="RightToLeft">
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="NotificationHistoryTitleText" Text="تاریخچه اعلان ها و اقدامات" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        <Button x:Name="ClearHistoryBtn" Click="ClearHistoryBtn_Click" Grid.Column="1" Padding="6,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="پاکسازی تاریخچه">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="NotificationHistoryClearText" Text="پاکسازی" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="350">
                                        <StackPanel x:Name="NotificationHistoryStack" Spacing="8">
                                            <TextBlock x:Name="EmptyHistoryText" Text="هنوز هیچ اعلانی ثبت نشده است." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="SettingsHeaderBtn" Click="SettingsHeaderBtn_Click" AutomationProperties.Name="تنظیمات برنامه" ToolTipService.ToolTip="تنظیمات برنامه (Settings)" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Width="32" Height="32" Padding="0" CornerRadius="16">
                        <FontIcon x:Name="SettingsHeaderIcon" Glyph="&#xE713;" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Number3" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>

                <!-- Dedicated Reserved Space for Windows Caption Buttons (- □ ✕) -->
                <Border x:Name="CaptionButtonsSpacer" Grid.Column="3" Width="144" Background="Transparent" />
            </Grid>
        </Border>

        <!-- Main Body Content (Dynamic Direction RTL/LTR) -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" FlowDirection="RightToLeft" Margin="24,8,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Modern Fluent 2 Floating Segmented Pill Switcher — ساختار قبلیِ ناوبری که
                 از نوار عنوان به بالای محتوای اصلی برگشته تا هم وسط باشد و هم فضا را نگیرد. -->
            <Border Grid.Row="0"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource AppHeaderPillBrush}"
                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="19"
                    Padding="3"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <!-- Dashboard Tab Pill Button -->
                    <Button x:Name="NavDashboardBtn"
                            Click="NavDashboardBtn_Click"
                            AutomationProperties.Name="داشبورد بهینه سازی"
                            Height="34"
                            Padding="18,0"
                            CornerRadius="16"
                            Background="{ThemeResource AppCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AppCardBorderBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="NavDashboardIcon" Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="NavDashboardText" Text="داشبورد بهینه سازی" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <!-- میان‌بر صفحه‌کلید: تغییر نما بدون ماوس -->
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>

                    <!-- System Tools Tab Pill Button -->
                    <Button x:Name="NavToolsBtn"
                            Click="NavToolsBtn_Click"
                            AutomationProperties.Name="ابزارهای سیستمی ویندوز"
                            Height="34"
                            Padding="18,0"
                            CornerRadius="16"
                            Background="Transparent"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="NavToolsIcon" Glyph="&#xEA86;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="NavToolsText" Text="ابزارهای سیستمی ویندوز" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Number2" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <!-- D1: نوار وضعیت سراسری — بالای هر دو نمای داشبورد و ابزارها دیده می شود -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar x:Name="StatusInfoBar" Grid.Row="0" IsOpen="False" Severity="Success" IsClosable="True" MaxWidth="960" HorizontalAlignment="Center" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />

                <!-- ======================================================= -->
                <!-- View 1: Unified 1-Click Dashboard                       -->
                <!-- ======================================================= -->
                <ScrollViewer x:Name="DashboardView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel x:Name="DashboardContentPanel" Spacing="10" HorizontalAlignment="Stretch" MaxWidth="960" Margin="24,0,24,20">
                        
                            <!-- 1. HERO CARD — هیروکارت داخل WebView2 (CleanC.hero.html) -->
                            <!-- BorderThickness صفر است: کادر و radius را خود HTML (.hero) می‌کشد تا
                                 کادر دوبار نشود و ارتفاع داخلی دقیقاً با height:100% داخل HTML بخواند. -->
                            <Border x:Name="HeroCard"
                                    CornerRadius="12"
                                    Height="170"
                                    Background="{ThemeResource AppCardBackgroundBrush}"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    Translation="0,0,32"
                                    Shadow="{StaticResource SharedCardShadow}">
                                <Hero:HeroHost x:Name="HeroHostXaml"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch" />
                            </Border>

                            <!-- ================================================================= -->
                            <!-- LIVE CLEANUP CARD & REPORT CARD (Preserved with exact contracts)  -->
                            <!-- ================================================================= -->
                            <Border x:Name="LiveCleanupCard" Visibility="Collapsed" MinHeight="310" CornerRadius="12" Padding="20,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" Translation="0,0,16" Shadow="{StaticResource SharedCardShadow}">
                                <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <ProgressRing x:Name="LiveCleanSpinner" Width="20" Height="20" IsIndeterminate="True" />
                                            <FontIcon x:Name="LiveCleanDoneIcon" Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock x:Name="LiveCleanStatusTitle" Text="در حال پویش هوشمند سرفصل های سیستم..." FontWeight="SemiBold" FontSize="13.5" />
                                                <TextBlock x:Name="LiveCleanPhaseSubtitle" Text="در حال پردازش گام به گام سرفصل ها..." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="LiveFreedCounterText" Grid.Column="2" Text="+ 0 بایت آزاد شد" FontSize="15" FontWeight="Bold" Language="en-US" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    </Grid>

                                    <ProgressBar x:Name="LiveCleanProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" CornerRadius="2" HorizontalAlignment="Stretch" />

                                    <ListView x:Name="LiveCleanListView" SelectionMode="None" Height="220" HorizontalAlignment="Stretch">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{Binding ItemBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,2,0,4" HorizontalAlignment="Stretch">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                                        <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <ProgressRing IsActive="{Binding IsLoading}" Width="16" Height="16" Visibility="{Binding SpinnerVisibility}" />
                                                            <FontIcon Glyph="{Binding CurrentGlyph}" FontSize="15" Foreground="{Binding GlyphBrush}" Visibility="{Binding GlyphVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="{Binding StatusBadgeBackgroundBrush}" BorderThickness="0" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeForegroundBrush}" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CleanupReportCard" Visibility="Collapsed" CornerRadius="12" Padding="22,18" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" Translation="0,0,16" Shadow="{StaticResource SharedCardShadow}">
                                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                                <FontIcon Glyph="&#xE73E;" FontSize="18" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="گزارش نهایی و سلسله مراتبی بهینه سازی سیستم" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="عملیات با موفقیت پایان یافت؛ جزئیات سرفصل ها و تغییرات اعمال شده در زیر آمده است:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                            <TextBlock x:Name="ReportTotalFreedText" Text="+ 0 بایت آزاد شد" FontSize="14" FontWeight="Bold" Language="en-US" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource AppHeaderBorderBrush}" HorizontalAlignment="Stretch" />
                                    <StackPanel x:Name="ReportGroupsContainer" Spacing="12" HorizontalAlignment="Stretch" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                        <TextBlock Text="فایل های موقت با موفقیت پاکسازی شدند و به اطلاعات شخصی آسیبی نرسید." FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                        <Button x:Name="CloseReportBtn" Click="CloseReportBtn_Click" Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Padding="20,8" CornerRadius="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                                                <TextBlock Text="تأیید و بازگشت به داشبورد" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ================================================================= -->
                            <!-- 2. ANALYTICS ROW 1 (Grid 4 columns: 1.15* 1* 1* 1*)               -->
                            <!-- ================================================================= -->
                            <Grid x:Name="BentoGrid" ColumnSpacing="12" RowSpacing="12" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Health Score (Arc Gauge + Big CountUp Number) -->
                                <Border x:Name="HealthScoreCard"
                                        Grid.Column="0"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        MinHeight="156"
                                        Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Stretch"
                                        Translation="0,0,16"
                                        Shadow="{StaticResource SharedCardShadow}"
                                        AutomationProperties.Name="امتیاز سلامت سیستم">
                                    <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="CardHealthTitle" Text="امتیاز سلامت سیستم" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border x:Name="HealthScoreStatusBadge" Grid.Column="1" HorizontalAlignment="Right" Background="#25F5A524" BorderBrush="#50F5A524" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                                <TextBlock x:Name="HealthScoreStatusPill" Text="متوسط" FontSize="10.5" FontWeight="SemiBold" Foreground="#F5A524" />
                                            </Border>
                                        </Grid>

                                        <!-- Semicircle Arc Gauge (Explicit LeftToRight to avoid coordinate flipping in RTL) -->
                                        <Grid Height="80" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" FlowDirection="LeftToRight">
                                            <Canvas Width="170" Height="80" FlowDirection="LeftToRight">
                                                <!-- Track Background Arc -->
                                                <Path Stroke="{ThemeResource HealthGaugeTrackBrush}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.Data>
                                                        <PathGeometry>
                                                            <PathFigure StartPoint="17,74" IsClosed="False">
                                                                <ArcSegment Point="153,74" Size="68,68" SweepDirection="Clockwise" IsLargeArc="False" />
                                                            </PathFigure>
                                                        </PathGeometry>
                                                    </Path.Data>
                                                </Path>
                                                <!-- Value Arc -->
                                                <Path x:Name="HealthGaugeArcPath" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>

                                            <!-- Big Number LTR -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Spacing="4">
                                                <TextBlock x:Name="HealthScoreValueText" Text="62" FontSize="26" FontWeight="Bold" FlowDirection="LeftToRight" Language="en-US" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="HealthScoreOutOfText" Text="از 100" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Subtitle -->
                                        <TextBlock x:Name="HealthScoreDescText" Text="سیستم نیازمند آزادسازی رم و بهینه سازی فایل ها" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: RAM Card -->
                                <Border x:Name="BentoRamCard"
                                        Grid.Column="1"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Stretch"
                                        Translation="0,0,16"
                                        Shadow="{StaticResource SharedCardShadow}"
                                        AutomationProperties.Name="حافظه رم">
                                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                        <!-- Header: Icon Chip + Title + Status Pill -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}">
                                                    <FontIcon Glyph="&#xE9D2;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="CardRamTitle" Text="حافظه رم" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" HorizontalAlignment="Right" Background="{ThemeResource AppCardSecondaryBrush}" CornerRadius="5" Padding="7,2">
                                                <TextBlock x:Name="CardRamStatusText" Text="روان" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- Big Metric (22pt Bold LTR) -->
                                        <TextBlock x:Name="CardRamText" Text="—" FontSize="22" FontWeight="Bold" FlowDirection="LeftToRight" Language="en-US" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,4,0,0" />

                                        <!-- Subtitle -->
                                        <TextBlock x:Name="CardRamAvailableText" Text="فضای مصرفی در حال حاضر" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />

                                        <!-- Sparkline (44px) -->
                                        <Grid Height="44" Margin="0,8,0,0">
                                            <Path x:Name="RamSparklineFill" Fill="{ThemeResource AppSparklineFillBrush}" />
                                            <Path x:Name="RamSparklineStroke" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Grid>

                                        <!-- Collapsed legacy elements -->
                                        <StackPanel Visibility="Collapsed">
                                            <ProgressBar x:Name="CardRamProgress" />
                                            <TextBlock x:Name="CardRamTotalBadge" Language="en-US" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: CPU Card -->
                                <Border x:Name="BentoCpuCard"
                                        Grid.Column="2"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Stretch"
                                        Translation="0,0,16"
                                        Shadow="{StaticResource SharedCardShadow}"
                                        AutomationProperties.Name="پردازنده">
                                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}">
                                                    <FontIcon Glyph="&#xE770;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="CardCpuTitle" Text="پردازنده" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" HorizontalAlignment="Right" Background="{ThemeResource AppCardSecondaryBrush}" CornerRadius="5" Padding="7,2">
                                                 <TextBlock x:Name="CardPowerText" Text="متصل به برق" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- Big Metric (22pt Bold LTR) -->
                                        <TextBlock x:Name="CardCpuText" Text="18%" FontSize="22" FontWeight="Bold" FlowDirection="LeftToRight" Language="en-US" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,4,0,0" />

                                        <!-- Subtitle -->
                                        <TextBlock x:Name="CardGpuSummaryText" Text="بار پردازشی هسته ها" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />

                                        <!-- Sparkline (44px) -->
                                        <Grid Height="44" Margin="0,8,0,0">
                                            <Path x:Name="CpuSparklineFill" Fill="{ThemeResource AppSparklineFillBrush}" />
                                            <Path x:Name="CpuSparklineStroke" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Grid>

                                        <!-- Collapsed legacy elements -->
                                        <StackPanel Visibility="Collapsed">
                                            <ProgressBar x:Name="CardCpuProgress" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Network Card (Live Network / Internet Speed) -->
                                <Border x:Name="BentoDiskCard"
                                        Grid.Column="3"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Stretch"
                                        Translation="0,0,16"
                                        Shadow="{StaticResource SharedCardShadow}"
                                        AutomationProperties.Name="سرعت اینترنت">
                                    <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}">
                                                    <FontIcon Glyph="&#xE839;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="CardDiskTitle" Text="سرعت اینترنت" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" HorizontalAlignment="Right" Background="{ThemeResource AppCardSecondaryBrush}" CornerRadius="5" Padding="7,2">
                                                <TextBlock x:Name="CardDiskHealthText" Text="آنلاین" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <!-- Big Metric (22pt Bold LTR) -->
                                        <TextBlock x:Name="CardDiskText" Text="0.0 Mbps" FontSize="22" FontWeight="Bold" FlowDirection="LeftToRight" Language="en-US" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,4,0,0" />

                                        <!-- Subtitle -->
                                        <TextBlock x:Name="CardDiskTypeBadge" Text="ترافیک لحظه ای اینترنت" FontSize="10.5" Language="en-US" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />

                                        <!-- Sparkline (44px) -->
                                        <Grid Height="44" Margin="0,8,0,0">
                                            <Path x:Name="DiskSparklineFill" Fill="{ThemeResource AppSparklineFillBrush}" />
                                            <Path x:Name="DiskSparklineStroke" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Grid>

                                        <!-- Collapsed legacy elements -->
                                        <StackPanel Visibility="Collapsed">
                                            <ProgressBar x:Name="CardDiskProgress" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ================================================================= -->
                            <!-- 3. ANALYTICS ROW 2 (Grid 2 columns: 1.5* 1*)                      -->
                            <!-- ================================================================= -->
                            <Grid x:Name="AnalysisRow2Grid" ColumnDefinitions="1.5*,1*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                <!-- Card 1: Disk Space Breakdown C: -->
                                <Border x:Name="DiskBreakdownCard"
                                        Grid.Column="0"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Stretch"
                                        Translation="0,0,16"
                                        Shadow="{StaticResource SharedCardShadow}"
                                        AutomationProperties.Name="تحلیل فضای دیسک C:">
                                    <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}">
                                                    <FontIcon Glyph="&#xE7C3;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="DiskBreakdownTitle" Text="تحلیل فضای دیسک C:" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="DiskBreakdownFreeBadge" Grid.Column="1" Text="—" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FlowDirection="LeftToRight" Language="en-US" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Segmented Storage Bar (Height 12, CornerRadius 6, gap 2px) — عرض ها در کد بر اساس داده واقعی ست می شود -->
                                        <Border Height="12" CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,4,0,2">
                                            <Grid x:Name="DiskBreakdownBar" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60*" />
                                                    <ColumnDefinition Width="20*" />
                                                    <ColumnDefinition Width="20*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" Margin="0,0,2,0" ToolTipService.ToolTip="فضای استفاده شده" />
                                                <Border Grid.Column="1" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.55" CornerRadius="3" Margin="0,0,2,0" ToolTipService.ToolTip="قابل پاکسازی" />
                                                <Border Grid.Column="2" Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.35" CornerRadius="3" ToolTipService.ToolTip="آزاد" />
                                            </Grid>
                                        </Border>

                                        <!-- 2-Column Legend (matching .leg in preview HTML) -->
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="14" Margin="0,4,0,0">
                                            <!-- Column 1 -->
                                            <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*,Auto">
                                                <Border Width="8" Height="8" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock x:Name="DiskLegendUsedLabel" Grid.Column="1" Text="استفاده شده" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DiskLegendUsedPct" Grid.Column="2" Text="—" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FlowDirection="LeftToRight" Language="en-US" VerticalAlignment="Center" />
                                            </Grid>

                                            <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*,Auto">
                                                <Border Width="8" Height="8" CornerRadius="3" Background="{ThemeResource TextFillColorTertiaryBrush}" Opacity="0.35" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock x:Name="DiskLegendFreeLabel" Grid.Column="1" Text="آزاد" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DiskLegendFreePct" Grid.Column="2" Text="—" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FlowDirection="LeftToRight" Language="en-US" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Column 2 -->
                                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*,Auto">
                                                <Border Width="8" Height="8" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.55" VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock x:Name="DiskLegendCleanableLabel" Grid.Column="1" Text="قابل پاکسازی" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="DiskLegendCleanablePct" Grid.Column="2" Text="—" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FlowDirection="LeftToRight" Language="en-US" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: 7-Day Cleanup History (Columns matching preview HTML) -->
                                <Border x:Name="CleanupsHistoryCard"
                                        Grid.Column="1"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Background="{ThemeResource AppCardBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppCardBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Stretch"
                                        Translation="0,0,16"
                                        Shadow="{StaticResource SharedCardShadow}"
                                        AutomationProperties.Name="فضای آزادشده در ۷ روز اخیر">
                                    <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                                        <!-- Header -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}">
                                                <FontIcon Glyph="&#xE9F9;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="CleanupHistoryTitle" Text="فضای آزادشده در ۷ روز اخیر" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Bars Chart (Height 102, Direction LTR) — داده ها از تاریخچه واقعی خوانده می شوند -->
                                        <Grid x:Name="CleanupHistoryBars" Height="102" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="0,4,0,0" FlowDirection="LeftToRight" Language="en-US">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                <Border Height="3" Width="18" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.18" CornerRadius="5,5,2,2" />
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                <Border Height="3" Width="18" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.18" CornerRadius="5,5,2,2" />
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                <Border Height="3" Width="18" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.18" CornerRadius="5,5,2,2" />
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                <Border Height="3" Width="18" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.18" CornerRadius="5,5,2,2" />
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                <Border Height="3" Width="18" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.18" CornerRadius="5,5,2,2" />
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="5" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                <Border Height="3" Width="18" Background="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.18" CornerRadius="5,5,2,2" />
                                                <TextBlock Text="—" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="4">
                                                <TextBlock Text="—" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                                <Border Height="3" Width="18" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="5,5,2,2" />
                                                <TextBlock Text="—" FontSize="9.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ================================================================= -->
                            <!-- 4. CUSTOMIZATION EXPANDER (3-column card grid in preview HTML)    -->
                            <!-- ================================================================= -->
                            <Border CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Translation="0,0,16" Shadow="{StaticResource SharedCardShadow}" Margin="0,2,0,0">
                                <Expander x:Name="AdvancedCleanExpander" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Resources>
                                        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{ThemeResource ExpanderHeaderHoverColor}" />
                                        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{ThemeResource ExpanderHeaderPressedColor}" />
                                        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                                    </Expander.Resources>
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock x:Name="AdvancedCleanExpanderTitle" Text="سفارشی سازی موارد پاکسازی" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="AdvancedCleanTotalText" Grid.Column="2" Text="6 مورد انتخاب شده" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Language="en-US" />
                                        </Grid>
                                    </Expander.Header>

                                    <Expander.Content>
                                        <StackPanel Spacing="10" Padding="8,10" HorizontalAlignment="Stretch">
                                            <!-- Dynamic Categorized Hierarchy for Files, Registry, Apps, Services & Startup -->
                                            <StackPanel x:Name="AdvancedGroupsContainer" Visibility="Visible" Spacing="8" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </Expander.Content>
                                </Expander>
                            </Border>

                            <!-- (D1) نوار وضعیت به سطح Grid والد منتقل شد تا در تب ابزارها هم دیده شود -->

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ======================================================= -->
                <!-- View 2: System Tools & Diagnostics                      -->
                <!-- ======================================================= -->
                <ScrollViewer x:Name="ToolsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel x:Name="ToolsContentPanel" Spacing="16" HorizontalAlignment="Stretch" MaxWidth="960" Margin="24,8,24,32">
                            
                            <!-- =================================================== -->
                            <!-- Sub-View 0: Tools Launcher Grid                     -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolsLauncherPanel" Spacing="14" Visibility="Visible">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="ToolsHeaderTitle" Text="ابزارهای سیستمی" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="ToolsHeaderSubtitle" Text="مجموعه ابزارهای کاربردی مدیریت و بهینه‌سازی سیستم" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>

                                <!-- Section 1: Frequently Used (پرکاربرد) -->
                                <TextBlock x:Name="ToolsSectionFrequentlyUsed" Text="پرکاربرد" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,8,4,0" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12" HorizontalAlignment="Stretch">
                                    <!-- Card 1: Windows Update (Featured Accent Tint) -->
                                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1" MinHeight="132">
                                        <Button Click="LaunchToolPage_Click" Tag="windows_update" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="18" HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <FontIcon Glyph="&#xE76B;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                <StackPanel VerticalAlignment="Stretch" Spacing="6">
                                                    <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <FontIcon x:Name="LauncherWindowsUpdateIcon" Glyph="&#xE895;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                            <FontIcon.RenderTransform>
                                                                <RotateTransform x:Name="LauncherUpdateIconRotate" Angle="0" />
                                                            </FontIcon.RenderTransform>
                                                        </FontIcon>
                                                    </Border>
                                                    <TextBlock x:Name="LauncherWindowsUpdateTitle" Text="آپدیت ویندوز" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock x:Name="LauncherWindowsUpdateDesc" Text="بررسی، توقف ۵ هفته ای و رفع گیر کردن دانلود" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    <Border Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="5" Padding="8,3" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1">
                                                        <TextBlock x:Name="LauncherWindowsUpdateBadge" Text="سیستم به روز است ✓" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Border>

                                    <!-- Card 2: App Uninstaller -->
                                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" MinHeight="132">
                                        <Button Click="LaunchToolPage_Click" Tag="app_uninstaller" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="18" HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <FontIcon Glyph="&#xE76B;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                <StackPanel VerticalAlignment="Stretch" Spacing="6">
                                                    <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock x:Name="LauncherUninstallerTitle" Text="حذف نرم افزارها" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock x:Name="LauncherUninstallerDesc" Text="لیست برنامه ها با آیکون اختصاصی و حذف آسان" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    <Border Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="5" Padding="8,3" Background="{ThemeResource AppCardSecondaryBrush}">
                                                        <TextBlock x:Name="LauncherUninstallerBadge" Text="آماده اسکن برنامه ها" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Border>

                                    <!-- Card 3: Startup Apps -->
                                    <Border Grid.Row="1" Grid.Column="0" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" MinHeight="132">
                                        <Button Click="LaunchToolPage_Click" Tag="startup_manager" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="18" HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <FontIcon Glyph="&#xE76B;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                <StackPanel VerticalAlignment="Stretch" Spacing="6">
                                                    <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <FontIcon Glyph="&#xE7E8;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock x:Name="LauncherStartupTitle" Text="برنامه های استارتاپ" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock x:Name="LauncherStartupDesc" Text="مدیریت برنامه های شروع خودکار و سرعت بوت" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    <Border Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="5" Padding="8,3" Background="{ThemeResource AppCardSecondaryBrush}">
                                                        <TextBlock x:Name="LauncherStartupBadge" Text="بررسی استارتاپ" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Border>

                                    <!-- Card 4: Internet Speed Test (Speedometer Icon &#xEC48;) -->
                                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" MinHeight="132">
                                        <Button Click="LaunchToolPage_Click" Tag="speed_test" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="12" Padding="18" HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <FontIcon Glyph="&#xE76B;" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                <StackPanel VerticalAlignment="Stretch" Spacing="6">
                                                    <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <FontIcon Glyph="&#xEC48;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock x:Name="LauncherSpeedTestTitle" Text="تست سرعت اینترنت" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock x:Name="LauncherSpeedTestDesc" Text="سنجش دانلود واقعی، آپلود، پینگ و ISP" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    <Border Margin="0,6,0,0" HorizontalAlignment="Right" CornerRadius="5" Padding="8,3" Background="{ThemeResource AppCardSecondaryBrush}">
                                                        <TextBlock x:Name="LauncherSpeedTestBadge" Text="سنجش بلادرنگ پینگ و سرعت" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </Grid>

                                <!-- Section 2: Other Tools (سایر ابزارها - Clean Fluent Grid) -->
                                <TextBlock x:Name="ToolsSectionOtherTools" Text="سایر ابزارها" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,12,4,0" />
                                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10" HorizontalAlignment="Stretch">
                                    <!-- 1. Deep Storage -->
                                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Button Click="LaunchToolPage_Click" Tag="deep_storage" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE74C;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="LauncherToolDeepStorageText" Grid.Column="1" Text="پاکسازی عمیق دیسک" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>

                                    <!-- 2. System Specs -->
                                    <Border Grid.Row="0" Grid.Column="1" CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Button Click="LaunchToolPage_Click" Tag="system_specs" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE950;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="LauncherToolSpecsText" Grid.Column="1" Text="مشخصات سیستم" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>

                                    <!-- 3. Personalization -->
                                    <Border Grid.Row="0" Grid.Column="2" CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Button Click="LaunchToolPage_Click" Tag="personalization" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE790;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="LauncherToolPersonalizationText" Grid.Column="1" Text="استایل و گرافیک" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>

                                    <!-- 4. Driver Manager -->
                                    <Border Grid.Row="1" Grid.Column="0" CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Button Click="LaunchToolPage_Click" Tag="drivers" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xEA86;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="LauncherToolDriversText" Grid.Column="1" Text="مدیریت درایورها" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>

                                    <!-- 5. DNS Manager -->
                                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Button Click="LaunchToolPage_Click" Tag="dns_manager" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE80A;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="LauncherToolDnsText" Grid.Column="1" Text="تنظیم DNS و تحریم شکن" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>

                                    <!-- 6. Privacy & Debloat -->
                                    <Border Grid.Row="1" Grid.Column="2" CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Button Click="LaunchToolPage_Click" Tag="privacy_debloat" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="LauncherToolPrivacyText" Grid.Column="1" Text="حریم خصوصی و ضدجاسوسی" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>

                                    <!-- 7. Recycle Bin -->
                                    <Border Grid.Row="2" Grid.Column="0" CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Button Click="LaunchToolPage_Click" Tag="recycle_bin" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="14,12" HorizontalContentAlignment="Stretch">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock x:Name="LauncherToolRecycleBinText" Grid.Column="1" Text="سطل بازیافت" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 1: System Specs Full Page                  -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolSystemSpecsPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar (Fluent 2 Common Pattern) -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Width="36" Height="36" Padding="0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <FontIcon x:Name="ToolBackIcon1" Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="SpecsHeaderTitle" Text="مشخصات جامع سخت افزار" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="SpecsHeaderSubtitle" Text="اطلاعات لحظه ای پردازنده، رم، مادربرد، گرافیک، درایوها و لایسنس" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button Click="CopySpecsReport_Click" Height="32" Padding="14,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <TextBlock x:Name="CopySpecsBtnText" Text="کپی مشخصات" FontSize="12" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Click="RefreshSpecsPage_Click" Height="32" Padding="14,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                <TextBlock x:Name="RefreshSpecsBtnText" Text="به‌روزرسانی" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ProgressRing x:Name="SpecsLoadingSpinner" IsActive="True" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,24,0,0" />
                                <StackPanel x:Name="SpecsCardsContainer" Spacing="12" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 2: App Uninstaller Full Page               -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolAppUninstallerPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Width="36" Height="36" Padding="0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <FontIcon x:Name="ToolBackIcon2" Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="UninstallerHeaderTitle" Text="مدیریت و حذف نرم افزارها" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="UninstallerSummaryText" Text="در حال بارگذاری لیست برنامه ها..." FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Search & Sort Tools Bar -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" ColumnSpacing="10">
                                    <AutoSuggestBox x:Name="UninstallerSearchBox" PlaceholderText="جستجوی نرم افزار..." QueryIcon="Find" Height="34" TextChanged="UninstallerSearchBox_TextChanged" />
                                    <ComboBox x:Name="UninstallerSortBox" Grid.Column="1" SelectionChanged="UninstallerSortBox_SelectionChanged" Height="34" CornerRadius="6">
                                        <ComboBoxItem x:Name="UninstallerSortNewest" Content="جدیدترین نصب" IsSelected="True" />
                                        <ComboBoxItem x:Name="UninstallerSortLargest" Content="بیشترین حجم" />
                                        <ComboBoxItem x:Name="UninstallerSortName" Content="نام (الفبا)" />
                                    </ComboBox>
                                </Grid>

                                <!-- Batch Action Bar -->
                                <Border x:Name="UninstallerBatchBar" Visibility="Collapsed" CornerRadius="10" Padding="14,10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <CheckBox x:Name="UninstallerSelectAllCheck" Content="انتخاب همه" FontSize="12" VerticalAlignment="Center" Checked="UninstallerSelectAll_Checked" Unchecked="UninstallerSelectAll_Unchecked" />
                                        <TextBlock x:Name="UninstallerSelectedCountText" Grid.Column="1" Text="۰ برنامه انتخاب شده" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <Button x:Name="UninstallerBatchDeleteBtn" Grid.Column="2" Click="UninstallerBatchDeleteBtn_Click" Height="32" Padding="14,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <TextBlock x:Name="UninstallerBatchDeleteBtnText" Text="حذف انتخاب شده ها" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <ProgressRing x:Name="UninstallerLoadingSpinner" IsActive="True" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,24,0,0" />
                                <StackPanel x:Name="UninstallerAppsStack" Spacing="6" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 3: Internet Speed Test Full Page           -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolSpeedTestPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Width="36" Height="36" Padding="0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <FontIcon x:Name="ToolBackIcon3" Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="SpeedTestHeaderTitle" Text="تست سرعت اینترنت" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="SpeedTestHeaderSubtitle" Text="سنجش پهنای باند دانلود، آپلود و تاخیر از سرورهای Cloudflare" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Network Metadata Chips Bar -->
                                <Border CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                        <!-- IP Chip -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#1A3B82F6">
                                                <FontIcon Glyph="&#xE838;" FontSize="13" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="SpeedIpLabelText" Text="IP" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="SpeedIpChipText" Text="--.--.--.--" FontSize="12" FontWeight="SemiBold" FlowDirection="LeftToRight" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ISP Chip -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#1A10B981">
                                                <FontIcon Glyph="&#xEC27;" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="SpeedIspLabelText" Text="ISP" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="SpeedIspChipText" Text="در حال شناسایی..." FontSize="12" FontWeight="SemiBold" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Location Chip -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" Background="#1AF59E0B">
                                                <FontIcon Glyph="&#xE819;" FontSize="13" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="SpeedLocationLabelText" Text="موقعیت" FontSize="10.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="SpeedLocationChipText" Text="در حال شناسایی..." FontSize="12" FontWeight="SemiBold" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Central Speed Gauge Card -->
                                <Border CornerRadius="14" Padding="28,24" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" Translation="0,0,16" Shadow="{StaticResource SharedCardShadow}">
                                    <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                                        <!-- Phase Status Badge -->
                                        <Border HorizontalAlignment="Center" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="18,7">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="SpeedGaugePhaseText" Text="آماده شروع تست سرعت" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Speed Gauge Dial -->
                                        <Grid Width="250" Height="250" HorizontalAlignment="Center">
                                            <!-- Background Circular Track -->
                                            <Ellipse Width="240" Height="240" Stroke="{ThemeResource AppCardSecondaryBrush}" StrokeThickness="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <!-- WinUI ProgressRing as Gauge Meter -->
                                            <ProgressRing x:Name="SpeedGaugeRing" Width="240" Height="240" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <!-- Inside Gauge Content -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                                                <TextBlock x:Name="SpeedGaugeValueText" Text="0" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" Language="en-US" />
                                                <TextBlock Text="Mbps" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" FlowDirection="LeftToRight" Language="en-US" />
                                                <TextBlock x:Name="SpeedGaugeMBsText" Text="0 MB/s" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" FlowDirection="LeftToRight" Language="en-US" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                            <Button x:Name="StartSpeedTestBtn" Click="StartSpeedTestBtn_Click" Style="{ThemeResource AccentButtonStyle}" Height="36" Padding="28,0" CornerRadius="8">
                                                <TextBlock x:Name="StartSpeedTestBtnText" Text="شروع تست سرعت" FontSize="12.5" FontWeight="SemiBold" />
                                            </Button>
                                            <Button x:Name="StopSpeedTestBtn" Click="StopSpeedTestBtn_Click" IsEnabled="False" Height="36" Padding="20,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                <TextBlock x:Name="StopSpeedTestBtnText" Text="توقف تست" FontSize="12.5" FontWeight="SemiBold" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 3 Stat Cards Below Gauge (Ping, Download, Upload) -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" HorizontalAlignment="Stretch">
                                    <!-- Ping -->
                                    <Border Grid.Column="0" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#F59E0B" BorderThickness="0,0,0,3">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE916;" FontSize="13" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                <TextBlock x:Name="SpeedPingTitleText" Text="تاخیر پینگ (Ping)" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="SpeedPingValText" Text="-- ms" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" Language="en-US" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Download Speed -->
                                    <Border Grid.Column="1" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#10B981" BorderThickness="0,0,0,3">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="#10B981" VerticalAlignment="Center" />
                                                <TextBlock x:Name="SpeedDownloadTitleText" Text="سرعت دانلود" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="SpeedDownloadValText" Text="-- Mbps" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" Language="en-US" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Upload Speed -->
                                    <Border Grid.Column="2" CornerRadius="10" Padding="16,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="#3B82F6" BorderThickness="0,0,0,3">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="#3B82F6" VerticalAlignment="Center" />
                                                <TextBlock x:Name="SpeedUploadTitleText" Text="سرعت آپلود" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="SpeedUploadValText" Text="-- Mbps" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" Language="en-US" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Experience Ratings Card (Speedtest.net style) -->
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 4: Windows Personalization Full Page       -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolPersonalizationPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Width="36" Height="36" Padding="0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <FontIcon x:Name="ToolBackIcon4" Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
