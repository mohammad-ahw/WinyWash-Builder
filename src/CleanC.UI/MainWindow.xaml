                                    <!-- 6. Privacy & Debloat -->
                                    <Border Grid.Row="1" Grid.Column="2" CornerRadius="10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Button Click="LaunchToolPage_Click" Tag="privacy_debloat" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,10" HorizontalContentAlignment="Stretch">
