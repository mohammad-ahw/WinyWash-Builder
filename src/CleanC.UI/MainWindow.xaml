                                            <TextBlock Text="اطلاعات لحظه‌ای پردازنده، رم، مادربرد، گرافیک، درایوها، لایسنس و باتری" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Click="CopySpecsReport_Click" Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                                <TextBlock Text="کپی مشخصات" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="RefreshSpecsPage_Click" Height="36" Padding="14,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                                <TextBlock Text="بروزرسانی" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ProgressRing x:Name="SpecsLoadingSpinner" IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" Margin="0,32,0,0" />
                                <StackPanel x:Name="SpecsCardsContainer" Spacing="12" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 2: App Uninstaller Full Page               -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolAppUninstallerPanel" Spacing="16" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" Width="38" Height="38" Padding="0" CornerRadius="19" Background="{ThemeResource AppHeaderPillBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" ToolTipService.ToolTip="بازگشت به ابزارها">
                                            <FontIcon Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="مدیریت و حذف نرم‌افزارهای نصب‌شده" FontSize="16" FontWeight="Bold" LineHeight="24" />
                                            <TextBlock x:Name="UninstallerSummaryText" Text="در حال بارگذاری لیست برنامه‌ها..." FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" LineHeight="18" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Search & Sort Controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
