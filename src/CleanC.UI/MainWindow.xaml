                                                <TextBlock x:Name="UpdateRow1Sub" Text="توقف دریافت بسته ها مطابق مکانیزم رسمی تنظیمات ویندوز" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="PauseUpdatesBtn" Click="PauseUpdatesBtn_Click" Content="توقف ۵ هفته ای" Height="32" FontSize="11.5" FontWeight="SemiBold" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
                                                <Button x:Name="ResumeUpdatesBtn" Click="ResumeUpdatesBtn_Click" Content="ادامه دریافت" Height="32" FontSize="11.5" FontWeight="SemiBold" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Row 2: Windows Update Service (wuauserv) -->
                                    <Border CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock x:Name="UpdateRow2Title" Text="سرویس Windows Update (wuauserv)" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="UpdateRow2Sub" Text="فعال یا غیرفعال سازی کامل سرویس پس زمینه" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="DisableUpdateServiceBtn" Click="DisableUpdateServiceBtn_Click" Content="غیرفعال سازی" Height="32" FontSize="11.5" FontWeight="SemiBold" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
