                                                <FontIcon x:Name="ToolBackIcon1" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ToolBackText1" Text="بازگشت" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="مشخصات جامع سخت‌افزار" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="اطلاعات لحظه‌ای پردازنده، رم، مادربرد، گرافیک، درایوها و لایسنس" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button Click="CopySpecsReport_Click" Height="32" Padding="14,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <TextBlock Text="کپی مشخصات" FontSize="12" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Click="RefreshSpecsPage_Click" Height="32" Padding="14,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                <TextBlock Text="بروزرسانی" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ProgressRing x:Name="SpecsLoadingSpinner" IsActive="True" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,24,0,0" />
                                <StackPanel x:Name="SpecsCardsContainer" Spacing="12" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 2: App Uninstaller Full Page               -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolAppUninstallerPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Height="32" Padding="10,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon x:Name="ToolBackIcon2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ToolBackText2" Text="بازگشت" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="مدیریت و حذف نرم‌افزارها" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="UninstallerSummaryText" Text="در حال بارگذاری لیست برنامه‌ها..." FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Search & Sort Tools Bar -->
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" ColumnSpacing="10">
                                    <AutoSuggestBox x:Name="UninstallerSearchBox" PlaceholderText="جستجوی نرم‌افزار..." QueryIcon="Find" Height="34" TextChanged="UninstallerSearchBox_TextChanged" />
                                    <ComboBox x:Name="UninstallerSortBox" Grid.Column="1" SelectionChanged="UninstallerSortBox_SelectionChanged" Height="34" CornerRadius="6">
                                        <ComboBoxItem Content="جدیدترین نصب" IsSelected="True" />
                                        <ComboBoxItem Content="بیشترین حجم" />
                                        <ComboBoxItem Content="نام (الفبا)" />
                                    </ComboBox>
                                </Grid>

                                <!-- Batch Action Bar -->
                                <Border x:Name="UninstallerBatchBar" Visibility="Collapsed" CornerRadius="10" Padding="14,10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <CheckBox x:Name="UninstallerSelectAllCheck" Content="انتخاب همه" FontSize="12" VerticalAlignment="Center" Checked="UninstallerSelectAll_Checked" Unchecked="UninstallerSelectAll_Unchecked" />
                                        <TextBlock x:Name="UninstallerSelectedCountText" Grid.Column="1" Text="۰ برنامه انتخاب شده" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <Button x:Name="UninstallerBatchDeleteBtn" Grid.Column="2" Click="UninstallerBatchDeleteBtn_Click" Height="32" Padding="14,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <TextBlock x:Name="UninstallerBatchDeleteBtnText" Text="حذف انتخاب‌شده‌ها" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <ProgressRing x:Name="UninstallerLoadingSpinner" IsActive="True" Width="32" Height="32" HorizontalAlignment="Center" Margin="0,24,0,0" />
                                <StackPanel x:Name="UninstallerAppsStack" Spacing="6" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 3: Internet Speed Test Full Page           -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolSpeedTestPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Height="32" Padding="10,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon x:Name="ToolBackIcon3" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ToolBackText3" Text="بازگشت" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="تست سرعت اینترنت" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="سنجش پهنای باند دانلود، آپلود و تاخیر از سرورهای Cloudflare" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Network Metadata Chips Bar -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                    <!-- IP Chip -->
                                    <Border CornerRadius="8" Padding="12,8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <TextBlock Text="IP" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SpeedIpChipText" Text="--.--.--.--" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                                            <Border x:Name="SpeedVpnBadge" Visibility="Collapsed" CornerRadius="4" Background="#263B82F6" BorderBrush="#803B82F6" BorderThickness="1" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="🛡️ VPN فعال" FontSize="10" Foreground="#60A5FA" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- ISP Chip -->
                                    <Border Grid.Column="1" CornerRadius="8" Padding="12,8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <TextBlock Text="ISP" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SpeedIspChipText" Text="در حال شناسایی..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Location Chip -->
                                    <Border Grid.Column="2" CornerRadius="8" Padding="12,8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <TextBlock Text="موقعیت" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SpeedLocationChipText" Text="در حال شناسایی..." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxWidth="160" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Central Arc Speed Gauge Card -->
                                <Border CornerRadius="12" Padding="24,20" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                                        <!-- Phase Status Text -->
                                        <TextBlock x:Name="SpeedGaugePhaseText" Text="آماده شروع تست سرعت" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />

                                        <!-- Gauge Visual Representation -->
                                        <Grid Width="220" Height="130" HorizontalAlignment="Center">
                                            <!-- Background semi-circle track arc -->
                                            <Path Stroke="{ThemeResource AppCardSecondaryBrush}" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                <Path.Data>
                                                    <PathGeometry>
                                                        <PathFigure StartPoint="15,105">
                                                            <ArcSegment Point="205,105" Size="95,95" SweepDirection="Clockwise" IsLargeArc="False" />
                                                        </PathFigure>
                                                    </PathGeometry>
                                                </Path.Data>
                                            </Path>

                                            <!-- Central Value & Mbps text -->
                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" Spacing="2">
                                                <TextBlock x:Name="SpeedGaugeValueText" Text="0" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" />
                                                <TextBlock Text="Mbps" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" FlowDirection="LeftToRight" />
                                                <TextBlock x:Name="SpeedGaugeMBsText" Text="0 MB/s" FontSize="10.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" FlowDirection="LeftToRight" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- ProgressRing contract preserved -->
                                            <ProgressRing x:Name="SpeedGaugeRing" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False" Visibility="Collapsed" />
                                        </Grid>

                                        <!-- Action Buttons -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,4,0,0">
                                            <Button x:Name="StartSpeedTestBtn" Click="StartSpeedTestBtn_Click" Style="{ThemeResource AccentButtonStyle}" Height="34" Padding="26,0" CornerRadius="6">
                                                <TextBlock Text="شروع تست سرعت" FontSize="12" FontWeight="SemiBold" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 3 Stat Cards Below Gauge (Ping, Download, Upload) -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                    <!-- Ping -->
                                    <Border Grid.Column="0" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="تاخیر پینگ" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="SpeedPingValText" Text="-- ms" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Download -->
                                    <Border Grid.Column="1" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="سرعت دانلود" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="SpeedDownloadValText" Text="-- Mbps" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Upload -->
                                    <Border Grid.Column="2" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="سرعت آپلود" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="SpeedUploadValText" Text="-- Mbps" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FlowDirection="LeftToRight" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Experience Ratings Card (Speedtest.net style) -->
                                <Border x:Name="SpeedExperienceCard" Visibility="Collapsed" CornerRadius="12" Padding="18,16" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="ارزیابی تجربه کاربری اینترنت (User Experience Ratings)" FontSize="13" FontWeight="Bold" />
                                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                            <!-- Web Browsing -->
                                            <Border Grid.Column="0" CornerRadius="8" Padding="10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="وب‌گردی" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="SpeedExpWebText" Text="عالی" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Video Streaming -->
                                            <Border Grid.Column="1" CornerRadius="8" Padding="10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="استریم ویدیو" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="SpeedExpVideoText" Text="4K UHD" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Gaming -->
                                            <Border Grid.Column="2" CornerRadius="8" Padding="10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7FC;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="بازی آنلاین" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="SpeedExpGamingText" Text="عالی" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Video Calling -->
                                            <Border Grid.Column="3" CornerRadius="8" Padding="10" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE717;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="تماس ویدیویی" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="SpeedExpCallText" Text="کیفیت HD" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 4: Windows Personalization Full Page       -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolPersonalizationPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Height="32" Padding="10,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon x:Name="ToolBackIcon4" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ToolBackText4" Text="بازگشت" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="استایل، تم و گرافیک ویندوز" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="اعمال آنی بدون نیاز به ریستارت" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="PersonalizationCardsContainer" Spacing="6" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 5: Startup Manager Full Page               -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolStartupManagerPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Height="32" Padding="10,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon x:Name="ToolBackIcon5" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ToolBackText5" Text="بازگشت" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="مدیریت برنامه‌های شروع خودکار" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="StartupManagerSummaryText" Text="مدیریت برنامه‌های استارتاپ و سرعت بوت ویندوز" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2" Click="RefreshStartupManager_Click" Height="32" Padding="14,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                            <TextBlock Text="بروزرسانی لیست" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel x:Name="StartupCardsContainer" Spacing="6" />
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 6: Windows Update Manager Full Page        -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolWindowsUpdatePanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Height="32" Padding="10,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon x:Name="ToolBackIcon6" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ToolBackText6" Text="بازگشت" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="مدیریت بروزرسانی‌های ویندوز" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="بررسی آپدیت‌ها، توقف رسمی ۵ هفته‌ای و رفع گیر کردن دانلود" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button x:Name="CheckUpdatesBtn" Grid.Column="2" Click="CheckUpdatesBtn_Click" Height="32" Padding="14,0" CornerRadius="6" Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ProgressRing x:Name="CheckUpdatesBtnSpinner" IsActive="False" Visibility="Collapsed" Width="14" Height="14" Foreground="White" />
                                            <FontIcon x:Name="CheckUpdatesBtnIcon" Glyph="&#xE72C;" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock x:Name="CheckUpdatesBtnText" Text="بررسی آپدیت‌های جدید" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Status Overview Banner -->
                                <Border CornerRadius="12" Padding="16" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                                        <Border Width="40" Height="40" CornerRadius="10" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ProgressRing x:Name="UpdateStatusIconSpinner" IsActive="False" Visibility="Collapsed" Width="20" Height="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <FontIcon x:Name="UpdateStatusIcon" Glyph="&#xE895;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock x:Name="UpdateStatusHeadlineText" Text="وضعیت آپدیت‌های سیستم‌عامل" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="UpdatePauseDetailText" Text="آپدیت‌ها طبق روند معمول دریافت می‌شوند." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="UpdateServiceDetailText" Text="سرویس Windows Update: فعال و آماده‌به‌کار" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="5" Padding="8,3" Background="{ThemeResource AppCardSecondaryBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="فعال" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Action Rows (ToolRow Pattern) -->
                                <StackPanel Spacing="6">
                                    <!-- Row 1: Pause 5 Weeks -->
                                    <Border CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE769;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="توقف رسمی تا ۵ هفته" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="توقف دریافت بسته‌ها مطابق مکانیزم رسمی تنظیمات ویندوز" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="PauseUpdatesBtn" Click="PauseUpdatesBtn_Click" Content="توقف ۵ هفته‌ای" Height="32" FontSize="11.5" FontWeight="SemiBold" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
                                                <Button x:Name="ResumeUpdatesBtn" Click="ResumeUpdatesBtn_Click" Content="ادامه دریافت" Height="32" FontSize="11.5" FontWeight="SemiBold" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Row 2: Windows Update Service (wuauserv) -->
                                    <Border CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="سرویس ویندوز آپدیت (wuauserv)" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="خاموش کردن کامل برای جلوگیری از مصرف پس‌زمینه" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="DisableUpdateServiceBtn" Click="DisableUpdateServiceBtn_Click" Content="غیرفعال‌سازی" Height="32" FontSize="11.5" FontWeight="SemiBold" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
                                                <Button x:Name="EnableUpdateServiceBtn" Click="EnableUpdateServiceBtn_Click" Content="فعال‌سازی" Height="32" FontSize="11.5" FontWeight="SemiBold" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Row 3: Fix Stuck Updates & Cache Flush -->
                                    <Border CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="رفع گیر کردن و خطاها" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="پاکسازی SoftwareDistribution و شروع مجدد سرویس‌ها" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button x:Name="FixStuckUpdatesBtn" Click="FixStuckUpdatesBtn_Click" Content="پاکسازی کش" Height="32" FontSize="11.5" FontWeight="SemiBold" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" Grid.Column="2" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Pending Updates Section -->
                                <StackPanel Spacing="8" Margin="0,4,0,0">
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                        <TextBlock Text="آپدیت‌های در انتظار نصب" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="PendingUpdatesCountText" Grid.Column="1" Text="۰ مورد" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>

                                    <ProgressRing x:Name="UpdatesLoadingSpinner" IsActive="False" Width="30" Height="30" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed" />
                                    <StackPanel x:Name="PendingUpdatesContainer" Spacing="6" />

                                    <Border x:Name="NoUpdatesBanner" Visibility="Collapsed" CornerRadius="10" Padding="16,14" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock Text="هیچ آپدیت معلق یا در انتظار نصبی یافت نشد. ویندوز کاملاً بروز است." FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View 7: Driver Manager Full Page                -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolDriversPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Height="32" Padding="10,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon x:Name="ToolBackIcon7" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ToolBackText7" Text="بازگشت" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="مدیریت و پاکسازی درایورها" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="شناسایی خطاها، پاکسازی ایمن نسخه‌های تکراری DriverStore" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CheckDriverUpdatesBtn" Click="CheckDriverUpdatesBtn_Click" Height="32" Padding="14,0" CornerRadius="6" Style="{ThemeResource AccentButtonStyle}">
                                            <TextBlock Text="بررسی آپدیت درایورها" FontSize="12" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Click="RefreshDrivers_Click" AutomationProperties.Name="بروزرسانی فهرست درایورها" ToolTipService.ToolTip="بروزرسانی فهرست درایورها" Height="32" Padding="14,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Summary Stats (3 Columns Grid) -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                    <Border CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="کل بسته‌های درایور" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DriversTotalCountText" Text="-- بسته" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="خطاهای سخت‌افزاری" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DriversErrorCountText" Text="۰ خطا" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="نسخه‌های تکراری" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="DriversDuplicateCountText" Text="۰ بسته" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Duplicate Cleanup Action Banner -->
                                <Border x:Name="DriversDuplicateBanner" Visibility="Collapsed" CornerRadius="12" Padding="16" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center">
