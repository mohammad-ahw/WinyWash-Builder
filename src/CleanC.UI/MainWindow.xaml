                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Width="36" Height="36" Padding="0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <FontIcon x:Name="ToolBackIcon6" Glyph="&#xE72A;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="WindowsUpdateHeaderTitle" Text="مدیریت به‌روزرسانی‌های ویندوز" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="WindowsUpdateHeaderSubtitle" Text="بررسی آپدیت ها، توقف رسمی ۵ هفته ای و رفع گیر کردن دانلود" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button x:Name="CheckUpdatesBtn" Grid.Column="2" Click="CheckUpdatesBtn_Click" Height="32" Padding="14,0" CornerRadius="6" Style="{ThemeResource AccentButtonStyle}">
