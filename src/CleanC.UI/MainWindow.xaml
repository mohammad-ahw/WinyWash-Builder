                                            <Button x:Name="CleanDismBtn" Click="CleanDismBtn_Click" HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="&#xE90F;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="پاکسازی DISM" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <TextBlock Text="WinSxS Component" FontSize="9.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- =================================================== -->
                            <!-- Sub-View: Recycle Bin Manager (F8)                  -->
                            <!-- =================================================== -->
                            <StackPanel x:Name="ToolRecycleBinPanel" Spacing="14" Visibility="Collapsed">
                                <!-- Top Bar -->
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Button Click="BackToToolsLauncher_Click" AutomationProperties.Name="بازگشت" ToolTipService.ToolTip="بازگشت به فهرست ابزارها" Height="32" Padding="10,0" CornerRadius="8" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon x:Name="ToolBackIcon11" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ToolBackText11" Text="بازگشت" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource AppAccentTintBrush}" BorderBrush="{ThemeResource AppAccentBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE74D;" FontSize="17" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="سطل بازیافت" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="پیش‌نمایش آیتم‌به‌آیتم؛ بازگردانی یا حذف قطعی تک‌تک اشیاء" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="RecycleBinRefreshBtn" Click="RecycleBinRefreshBtn_Click" Grid.Column="2" Height="34" Padding="16,0" CornerRadius="6" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                            <TextBlock Text="تازه‌سازی" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Summary -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" HorizontalAlignment="Stretch">
                                    <Border CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="تعداد اشیاء" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE8FD;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <TextBlock x:Name="RecycleBinCountText" Text="—" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" CornerRadius="10" Padding="14,12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="حجم اشغال‌شده" FontSize="11.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE964;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                            <TextBlock x:Name="RecycleBinSizeText" Text="—" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Bulk Actions -->
                                <Border CornerRadius="10" Padding="14,10" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <CheckBox x:Name="RecycleBinSelectAllCheck" Click="RecycleBinSelectAllCheck_Click" Content="انتخاب همه" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="RecycleBinSelectedCountText" Text="۰ مورد انتخاب شده" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button x:Name="RecycleBinRestoreSelectedBtn" Click="RecycleBinRestoreSelectedBtn_Click" Height="30" Padding="14,0" CornerRadius="6" FontSize="11.5" FontWeight="SemiBold" Style="{ThemeResource AccentButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE777;" FontSize="11" />
                                                    <TextBlock Text="بازگردانی انتخاب‌شده‌ها" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="RecycleBinDeleteSelectedBtn" Click="RecycleBinDeleteSelectedBtn_Click" Height="30" Padding="14,0" CornerRadius="6" FontSize="11.5" FontWeight="SemiBold" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                                    <TextBlock Text="حذف قطعی انتخاب‌شده‌ها" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="RecycleBinEmptyBtn" Click="RecycleBinEmptyBtn_Click" Height="30" Padding="14,0" CornerRadius="6" FontSize="11.5" Background="{ThemeResource AppCardSecondaryBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE75C;" FontSize="11" />
                                                    <TextBlock Text="خالی کردن کل سطل" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Loading -->
                                <Border x:Name="RecycleBinLoadingPanel" Visibility="Collapsed" CornerRadius="10" Padding="24" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ProgressRing Width="28" Height="28" IsIndeterminate="True" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="RecycleBinLoadingText" Text="در حال خواندن فهرست سطل بازیافت..." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Per-item preview list (built in code) -->
                                <StackPanel x:Name="RecycleBinItemsStack" Spacing="6" />

                                <Border x:Name="RecycleBinEmptyHint" Visibility="Collapsed" CornerRadius="10" Padding="24" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE74D;" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="سطل بازیافت خالی است؛ چیزی برای بازگردانی یا حذف وجود ندارد." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ======================================================= -->
                <!-- View 3: Application Settings (D2)                       -->
                <!-- ======================================================= -->
                <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid HorizontalAlignment="Stretch">
                        <StackPanel x:Name="SettingsContentPanel" Spacing="16" HorizontalAlignment="Center" MaxWidth="880" Margin="24,8,24,32">

                        <StackPanel Spacing="2">
                            <TextBlock x:Name="SettingsHeaderTitle" Text="تنظیمات برنامه" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="SettingsHeaderSubtitle" Text="شخصی‌سازی ظاهر، زبان، رفتار پس‌زمینه و تهیه گزارش" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <!-- 0. زبان برنامه (Language) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="SettingsLangTitle" Text="زبان برنامه (Language)" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsLangDesc" Text="انتخاب زبان رابط کاربری، جهت نوشتاری (RTL / LTR) و تایپوگرافی نیتیو سیستم‌عامل." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="210" VerticalAlignment="Center" SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="Auto" Content="خودکار (بر اساس ساعت و منطقه)" />
                                    <ComboBoxItem Tag="fa-IR" Content="🇮🇷 فارسی" />
                                    <ComboBoxItem Tag="en-US" Content="🇬🇧 English" />
                                    <ComboBoxItem Tag="ar-SA" Content="🇸🇦 العربية" />
                                    <ComboBoxItem Tag="zh-CN" Content="🇨🇳 简体中文" />
                                    <ComboBoxItem Tag="ja-JP" Content="🇯🇵 日本語" />
                                    <ComboBoxItem Tag="ko-KR" Content="🇰🇷 한국어" />
                                    <ComboBoxItem Tag="ru-RU" Content="🇷🇺 Русский" />
                                    <ComboBoxItem Tag="de-DE" Content="🇩🇪 Deutsch" />
                                    <ComboBoxItem Tag="fr-FR" Content="🇫🇷 Français" />
                                    <ComboBoxItem Tag="es-ES" Content="🇪🇸 Español" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- 1. ظاهر / تم (سه حالته) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock x:Name="SettingsThemeTitle" Text="تم برنامه" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsThemeDesc" Text="«سیستم» از تم ویندوز پیروی می‌کند؛ دو حالت دیگر تم را ثابت نگه می‌دارند." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                                    <RadioButton x:Name="ThemeSystemRadio" Content="سیستم" Click="ThemeRadio_Click" IsChecked="{x:Bind SettingsVm.IsThemeSystem, Mode=OneWay}" />
                                    <RadioButton x:Name="ThemeLightRadio" Content="روشن" Click="ThemeRadio_Click" IsChecked="{x:Bind SettingsVm.IsThemeLight, Mode=OneWay}" />
                                    <RadioButton x:Name="ThemeDarkRadio" Content="تاریک" Click="ThemeRadio_Click" IsChecked="{x:Bind SettingsVm.IsThemeDark, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. اجرا در پس‌زمینه و نوار وظیفه -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SettingsTrayTitle" Text="اجرا در پس‌زمینه و نوار وظیفه" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsTrayDesc" Text="کنترل حضور برنامه در پس‌زمینه و دسترسی سریع از طریق آیکون کنار ساعت ویندوز." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="SettingsCloseToTrayText" Text="با بستن پنجره خارج نشو؛ در پس‌زمینه (کنار ساعت) بمان" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.CloseToTray, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock x:Name="SettingsMinToTrayText" Text="کوچک‌نمایی پنجره، برنامه را در کنار ساعت پنهان کند" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.MinimizeToTray, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2.5. شروع خودکار همراه با ویندوز (F1) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="شروع همراه با ویندوز" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="با ورود به حساب کاربری، CleanC به‌صورت خودکار اجرا شود. همان آیتمی که در Task Manager › Startup دیده می‌شود." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="520" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoStartToggle" Grid.Column="1" IsOn="False" Toggled="AutoStartToggle_Toggled" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 2.6. رفتار حذف فایل‌های شخصی (F3) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="رفتار حذف فایل‌های شخصی" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="برای حذف تکراری‌ها، فایل‌های حجیم و سازماندهی دانلودها/دسکتاپ. کش و زباله‌ها همیشه قطعی حذف می‌شوند تا فضا واقعاً آزاد شود." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <RadioButton x:Name="DeleteModeRecycleRadio" Content="انتقال به سطل بازیافت (پیش‌فرض)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Checked="DeleteModeRadio_Checked" IsChecked="{x:Bind SettingsVm.IsDeleteRecycle, Mode=OneWay}" />
                                <RadioButton x:Name="DeleteModeQuarantineRadio" Content="قرنطینه‌ی CleanC — نگهداری در پوشه‌ی برنامه و قابل بازگردانی از مرکز بازیابی" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Checked="DeleteModeRadio_Checked" IsChecked="{x:Bind SettingsVm.IsDeleteQuarantine, Mode=OneWay}" />
                                <RadioButton x:Name="DeleteModePermanentRadio" Content="حذف قطعی — فوراً آزاد می‌شود اما قابل بازگردانی نیست" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Checked="DeleteModeRadio_Checked" IsChecked="{x:Bind SettingsVm.IsDeletePermanent, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- 3. بازیابی خودکار وضعیت (D2) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="بازیابی خودکار وضعیت" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="هر تغییر بلافاصله ذخیره می‌شود و در اجرای بعدی برگردانده می‌شود." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Text="اندازه و موقعیت پنجره" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="SavePlacementToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.SavePlacement, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Text="نمای آخر (داشبورد / ابزارها / تنظیمات)" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="SaveLastViewToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.SaveLastView, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Text="انتخاب‌های اسکن پاکسازی" FontSize="12.5" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ToggleSwitch x:Name="SaveScanSelectionsToggle" Grid.Column="1" IsOn="{x:Bind SettingsVm.SaveScanSelections, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="بازنشانی اندازه‌ی پنجره" Click="ResetWindowPlacementBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12" />
                                    <Button Content="بازنشانی همه‌ی تنظیمات" Click="ResetAllSettingsBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 4. اطلاعات / داده‌های برنامه -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock Text="داده‌های برنامه" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Text="تنظیمات:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SettingsPathText" Grid.Row="0" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Text="لاگ خطاها:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="LogPathText" Grid.Row="1" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="باز کردن پوشه‌ی تنظیمات" Click="OpenSettingsFolderBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12" />
                                    <Button Content="باز کردن پوشه‌ی لاگ‌ها" Click="OpenLogFolderBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 5. خروجی گزارش (F7) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SettingsExportTitle" Text="خروجی گزارش" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsExportDesc" Text="خروجی اطلاعات جامع سیستم جهت ارسال به هوش مصنوعی یا بررسی مشخصات سخت‌افزاری با فرمت متنی تمیز." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ExportAiReportBtn" Click="ExportAiReportBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE943;" FontSize="12" />
                                            <TextBlock x:Name="ExportAiReportText" Text="گزارش جامع برای هوش مصنوعی (.md)" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ExportSpecsTxtBtn" Click="ExportSpecsTxtBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                                            <TextBlock x:Name="ExportSpecsTxtText" Text="مشخصات کامل سیستم (.txt)" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 6. درباره (D8) -->
                        <Border CornerRadius="12" Background="{ThemeResource AppCardBackgroundBrush}" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SettingsAboutTitle" Text="درباره CleanC" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="SettingsAboutDesc" Text="برای گزارش باگ، اطلاعات عیب‌یابی را کپی و همراه با مشکل ارسال کنید." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Text="نسخه برنامه:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AboutVersionText" Grid.Row="0" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Text=".NET:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AboutDotNetText" Grid.Row="1" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FlowDirection="LeftToRight" />

                                    <TextBlock Grid.Row="2" Text="سیستم‌عامل:" FontSize="11.5" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="AboutOsText" Grid.Row="2" Grid.Column="1" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="CheckAppUpdatesBtn" Click="CheckAppUpdatesBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <TextBlock x:Name="CheckAppUpdatesText" Text="بررسی به‌روزرسانی" />
                                    </Button>
                                    <Button x:Name="OpenProjectPageBtn" Click="OpenProjectPageBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <TextBlock x:Name="OpenProjectPageText" Text="صفحه پروژه" />
                                    </Button>
                                    <Button x:Name="CopyDiagnosticsBtn" Click="CopyDiagnosticsBtn_Click" Background="Transparent" BorderBrush="{ThemeResource AppCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,7" FontSize="12">
                                        <TextBlock x:Name="CopyDiagnosticsText" Text="کپی اطلاعات عیب‌یابی" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
