<Application
    x:Class="CleanC.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Transparent canvas allowing native Desktop Acrylic frosted glass to shine through directly -->
                    <SolidColorBrush x:Key="WindowCanvasBrush" Color="#00000000" />

                    <!-- Solid, high-contrast typography so text never gets washed out -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#1E293B" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#475569" />
                    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#0F172A" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0F172A" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#0F172A" />
                    
                    <!-- Luminous Frosted Glass Card: crisp high contrast with genuine acrylic blur -->
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#D2FFFFFF" />
                    <!-- Specular glass rim border with crisp visible definition in Light mode -->
                    <LinearGradientBrush x:Key="AppCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#25000000" Offset="1.0" />
                    </LinearGradientBrush>
                    
                    <!-- Secondary surface inside cards (chips, sub-cards, list items, bento buttons) -->
                    <SolidColorBrush x:Key="AppCardSecondaryBrush" Color="#40F1F5F9" />
                    
                    <!-- Translucent Glass Header -->
                    <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="#B8FFFFFF" />
                    <LinearGradientBrush x:Key="AppHeaderBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                        <GradientStop Color="#18000000" Offset="1.0" />
                    </LinearGradientBrush>
                    
                    <!-- Quick action button pill background & segmented switcher background -->
                    <SolidColorBrush x:Key="AppHeaderPillBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="AppHeaderPillHoverBrush" Color="#22000000" />
                    
                    <!-- Running as Admin Pill Badge -->
                    <SolidColorBrush x:Key="AdminBadgeBackgroundBrush" Color="#200078D4" />
                    <SolidColorBrush x:Key="AdminBadgeBorderBrush" Color="#450078D4" />
                    <SolidColorBrush x:Key="AdminBadgeForegroundBrush" Color="#0078D4" />

                    <!-- Opaque Toast Notification Surface (100% solid, prevents text bleed-through) -->
                    <SolidColorBrush x:Key="AppToastBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppToastBorderBrush" Color="#CBD5E1" />

                    <!-- Dashboard V2 Redesign Tokens -->
                    <!-- کارت Aurora عمداً در هر دو تم تیره است تا متن سفید روی آن همیشه خوانا بماند -->
                    <SolidColorBrush x:Key="HeroCardBackgroundBrush" Color="#D90E1726" />
                    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="0.45" />
                        <GradientStop Color="#9905070C" Offset="1.0" />
                    </LinearGradientBrush>
                    <!-- Hero text/chip tokens (سطح تیره ثابت در هر دو تم) -->
                    <SolidColorBrush x:Key="HeroTitleBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroSubtitleBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="HeroChipLabelBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="HeroChipValueBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroChipBackgroundBrush" Color="#47000000" />
                    <SolidColorBrush x:Key="HeroChipBorderBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="HeroTelemetryLabelBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="HeroTelemetryValueBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroTelemetrySeparatorBrush" Color="#A0FFFFFF" />
                    <!-- هاور/فشردن هدر Expander باید بر اساس تم باشد (سیاه در لایت، سفید در دارک) -->
                    <Color x:Key="ExpanderHeaderHoverColor">#10000000</Color>
                    <Color x:Key="ExpanderHeaderPressedColor">#1A000000</Color>
                    <SolidColorBrush x:Key="HealthGaugeTrackBrush" Color="#18000000" />
                    <LinearGradientBrush x:Key="AppSparklineFillBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#250067C0" Offset="0.0" />
                        <GradientStop Color="#000067C0" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SparklineStrokeRamBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="SparklineStrokeCpuBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="SparklineStrokeDiskBrush" Color="{ThemeResource SystemAccentColor}" />
                    <LinearGradientBrush x:Key="SparklineFillRamBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#250067C0" Offset="0.0" />
                        <GradientStop Color="#000067C0" Offset="1.0" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SparklineFillCpuBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#250067C0" Offset="0.0" />
                        <GradientStop Color="#000067C0" Offset="1.0" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SparklineFillDiskBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#250067C0" Offset="0.0" />
                        <GradientStop Color="#000067C0" Offset="1.0" />
                    </LinearGradientBrush>

                    <!-- System Tools Redesign Tokens -->
                    <SolidColorBrush x:Key="AppAccentTintBrush" Color="#220067C0" />
                    <SolidColorBrush x:Key="AppAccentBorderBrush" Color="#660067C0" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <!-- Transparent canvas allowing native Desktop Acrylic frosted glass -->
                    <SolidColorBrush x:Key="WindowCanvasBrush" Color="#00000000" />
                    
                    <!-- High-contrast crisp typography in dark mode -->
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    
                    <!-- Frosted Dark Card: sleek dark slate allowing acrylic blur to shine through -->
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#661A1A1A" />
                    <!-- Subtle inner highlight via gradient border -->
                    <LinearGradientBrush x:Key="AppCardBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#45FFFFFF" Offset="0.0" />
                        <GradientStop Color="#0AFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                    
                    <!-- Secondary surface inside cards -->
                    <SolidColorBrush x:Key="AppCardSecondaryBrush" Color="#45303030" />
                    
                    <!-- Translucent Glass Header -->
                    <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="#40141414" />
                    <LinearGradientBrush x:Key="AppHeaderBorderBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#25FFFFFF" Offset="0.0" />
                        <GradientStop Color="#05FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                    
                    <!-- Quick action button pill background -->
                    <SolidColorBrush x:Key="AppHeaderPillBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="AppHeaderPillHoverBrush" Color="#35FFFFFF" />
                    
                    <!-- Running as Admin Pill Badge -->
                    <SolidColorBrush x:Key="AdminBadgeBackgroundBrush" Color="#2560CDFF" />
                    <SolidColorBrush x:Key="AdminBadgeBorderBrush" Color="#4560CDFF" />
                    <SolidColorBrush x:Key="AdminBadgeForegroundBrush" Color="#60CDFF" />

                    <!-- Opaque Toast Notification Surface in Dark Mode (100% solid, prevents text bleed-through) -->
                    <SolidColorBrush x:Key="AppToastBackgroundBrush" Color="#1E2430" />
                    <SolidColorBrush x:Key="AppToastBorderBrush" Color="#334155" />

                    <!-- Dashboard V2 Redesign Tokens -->
                    <!-- یکسان با Light تا کارت Aurora در هر دو تم تیره بماند -->
                    <SolidColorBrush x:Key="HeroCardBackgroundBrush" Color="#D90E1726" />
                    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="0.45" />
                        <GradientStop Color="#9905070C" Offset="1.0" />
                    </LinearGradientBrush>
                    <!-- Hero text/chip tokens (سطح تیره ثابت در هر دو تم) -->
                    <SolidColorBrush x:Key="HeroTitleBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroSubtitleBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="HeroChipLabelBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="HeroChipValueBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroChipBackgroundBrush" Color="#47000000" />
                    <SolidColorBrush x:Key="HeroChipBorderBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="HeroTelemetryLabelBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="HeroTelemetryValueBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroTelemetrySeparatorBrush" Color="#A0FFFFFF" />
                    <Color x:Key="ExpanderHeaderHoverColor">#15FFFFFF</Color>
                    <Color x:Key="ExpanderHeaderPressedColor">#25FFFFFF</Color>
                    <SolidColorBrush x:Key="HealthGaugeTrackBrush" Color="#20FFFFFF" />
                    <LinearGradientBrush x:Key="AppSparklineFillBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3060CDFF" Offset="0.0" />
                        <GradientStop Color="#0060CDFF" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SparklineStrokeRamBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="SparklineStrokeCpuBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="SparklineStrokeDiskBrush" Color="{ThemeResource SystemAccentColor}" />
                    <LinearGradientBrush x:Key="SparklineFillRamBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3060CDFF" Offset="0.0" />
                        <GradientStop Color="#0060CDFF" Offset="1.0" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SparklineFillCpuBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3060CDFF" Offset="0.0" />
                        <GradientStop Color="#0060CDFF" Offset="1.0" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SparklineFillDiskBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3060CDFF" Offset="0.0" />
                        <GradientStop Color="#0060CDFF" Offset="1.0" />
                    </LinearGradientBrush>

                    <!-- System Tools Redesign Tokens -->
                    <SolidColorBrush x:Key="AppAccentTintBrush" Color="#2460CDFF" />
                    <SolidColorBrush x:Key="AppAccentBorderBrush" Color="#6660CDFF" />
                </ResourceDictionary>

                <!-- =================================================================
                     HighContrast: همه سطوح کاملاً مات تعریف می شوند (بدون شیشه/آکریلیک)
                     تا روی طرح‌های High Contrast ویندوز متن ها خوانا بمانند
                     ================================================================= -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WindowCanvasBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFE8E8E8" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FFD0D0D0" />
                    <SolidColorBrush x:Key="DefaultTextForegroundThemeBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#FF121212" />
                    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FF737373" />
                    <SolidColorBrush x:Key="AppCardSecondaryBrush" Color="#FF1F1F1F" />
                    <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="#FF101010" />
                    <SolidColorBrush x:Key="AppHeaderBorderBrush" Color="#FF5A5A5A" />
                    <SolidColorBrush x:Key="AppHeaderPillBrush" Color="#FF2A2A2A" />
                    <SolidColorBrush x:Key="AppHeaderPillHoverBrush" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="AdminBadgeBackgroundBrush" Color="#FF2A2A2A" />
                    <SolidColorBrush x:Key="AdminBadgeBorderBrush" Color="#FF737373" />
                    <SolidColorBrush x:Key="AdminBadgeForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AppToastBackgroundBrush" Color="#FF101010" />
                    <SolidColorBrush x:Key="AppToastBorderBrush" Color="#FF737373" />
                    <SolidColorBrush x:Key="HeroCardBackgroundBrush" Color="#FF0E1726" />
                    <LinearGradientBrush x:Key="HeroScrimBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="0.45" />
                        <GradientStop Color="#9905070C" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HeroTitleBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroSubtitleBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="HeroChipLabelBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="HeroChipValueBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroChipBackgroundBrush" Color="#47000000" />
                    <SolidColorBrush x:Key="HeroChipBorderBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="HeroTelemetryLabelBrush" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="HeroTelemetryValueBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HeroTelemetrySeparatorBrush" Color="#A0FFFFFF" />
                    <Color x:Key="ExpanderHeaderHoverColor">#2A2A2A</Color>
                    <Color x:Key="ExpanderHeaderPressedColor">#3A3A3A</Color>
                    <SolidColorBrush x:Key="HealthGaugeTrackBrush" Color="#FF2F2F2F" />
                    <LinearGradientBrush x:Key="AppSparklineFillBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#60FFFFFF" Offset="0.0" />
                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SparklineStrokeRamBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="SparklineStrokeCpuBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="SparklineStrokeDiskBrush" Color="{ThemeResource SystemAccentColor}" />
                    <LinearGradientBrush x:Key="SparklineFillRamBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#60FFFFFF" Offset="0.0" />
                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SparklineFillCpuBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#60FFFFFF" Offset="0.0" />
                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="SparklineFillDiskBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#60FFFFFF" Offset="0.0" />
                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="AppAccentTintBrush" Color="#60FFFFFF" />
                    <SolidColorBrush x:Key="AppAccentBorderBrush" Color="#FF737373" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Fluent 2 / Glassmorphism Design Tokens -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei, Yu Gothic UI, Malgun Gothic, Tahoma</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="Control">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
