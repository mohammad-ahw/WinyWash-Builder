<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Management for WMI/DXDIAG and Microsoft.Data.Sqlite for reading the USO store.db in WindowsUpdateService -->
    <!-- System.Diagnostics.EventLog for reading boot degradation events (EventID=101) used by BootImpactService -->
    <!-- System.ServiceProcess.ServiceController for native service management (TelemetryOptimizer/WindowsUpdate) -->
    <PackageReference Include="System.Management" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <!-- دسترسی به متدهای ForTests (مثل SetRunKeyPathOverrideForTests) برای تست‌ها -->
    <InternalsVisibleTo Include="CleanC.Core.Tests" />
  </ItemGroup>
</Project>
